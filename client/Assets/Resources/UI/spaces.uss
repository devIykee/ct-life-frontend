/* Existing phone palette/Manrope. Conversation first, compact chrome, honest states. */
.ct-spaces .ct-space-content { min-width: 0; flex-shrink: 0; }
.ct-spaces .ct-space-content > *, .ct-spaces .ct-card > *, .ct-spaces .ct-space-person > .ct-grow > * { flex-shrink: 0; }
.ct-spaces .ct-h1 { font-size: 38px; margin: 0 0 12px 0; white-space: normal; }
.ct-spaces .ct-h2 { font-size: 30px; margin-bottom: 8px; white-space: normal; }
.ct-spaces .ct-body { font-size: 28px; white-space: normal; margin-bottom: 12px; }
.ct-spaces .ct-small { white-space: normal; font-size: 24px; margin-bottom: 8px; }
.ct-spaces .ct-eyebrow { font-size: 22px; margin-top: 20px; margin-bottom: 12px; color: var(--ct-muted); white-space: nowrap; flex-shrink: 0; }
.ct-spaces .ct-card { padding: 24px; margin-top: 12px; margin-bottom: 12px; border-width: 1px; border-color: var(--ct-line); border-radius: 20px; }
.ct-spaces .ct-btn { min-height: 136px; min-width: 240px; font-size: 28px; padding: 20px 24px; margin: 8px 0; white-space: normal; flex-shrink: 0; }
.ct-spaces .ct-space-list-heading { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; margin-bottom: 8px; }
.ct-spaces .ct-space-list-heading > .ct-h1 { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 16px; }
.ct-spaces .ct-space-list-heading > .ct-btn { width: 228px; min-width: 228px; flex-shrink: 0; }
.ct-spaces .ct-space-controls { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
.ct-spaces .ct-space-controls .ct-btn { flex-grow: 1; flex-basis: 0; margin-right: 12px; }
.ct-spaces .ct-space-message { white-space: normal; font-size: 26px; color: var(--ct-ink); padding: 16px 20px; border-left-width: 4px; border-left-color: var(--ct-deep); margin-bottom: 12px; flex-shrink: 0; }
.ct-spaces .ct-space-status { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; margin: 12px 0; flex-shrink: 0; }
.ct-spaces .ct-space-status .ct-eyebrow { margin-top: 0; }
.ct-spaces .ct-space-audio { font-size: 26px; color: var(--ct-ink); white-space: nowrap; flex-shrink: 0; }
.ct-spaces .ct-space-person { flex-direction: row; align-items: center; padding: 20px 0; border-bottom-width: 1px; border-bottom-color: var(--ct-line); flex-shrink: 0; }
.ct-spaces .ct-space-person .ct-grow { min-width: 0; margin-right: 16px; }
.ct-spaces .ct-space-person .ct-btn { width: 300px; flex-shrink: 0; }
.ct-spaces .ct-space-speaking { min-height: 32px; font-size: 24px; color: var(--ct-deep); white-space: nowrap; flex-shrink: 0; }
.ct-spaces .ct-space-input { margin: 12px 0; flex-direction: column; flex-shrink: 0; }
.ct-spaces .ct-space-input > .unity-base-field__label { font-size: 26px; margin: 0 0 12px 0; min-width: 0; white-space: normal; }
.ct-spaces .ct-space-input > .unity-base-field__input { min-height: 136px; padding: 20px 24px; border-width: 1px; border-color: var(--ct-line); border-radius: 16px; background-color: var(--ct-bg); color: var(--ct-ink); font-size: 30px; }
.ct-spaces .ct-space-review { font-size: 22px; color: var(--ct-ink); background-color: var(--ct-accent); padding: 16px 20px; margin-bottom: 16px; white-space: normal; flex-shrink: 0; }
