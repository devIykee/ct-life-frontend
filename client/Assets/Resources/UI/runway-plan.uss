/* One budget console with five expense strips. Existing CT palette and Manrope. */
.ct-runway-panel { width: 96%; height: 100%; max-width: 2600px; max-height: 1080px; padding: 20px 40px; background-color: var(--ct-ink); border-width: 2px; border-color: var(--ct-control-ring-active); border-radius: 24px; }
.ct-runway-panel .ct-desk-header { margin-bottom: 8px; align-items: center; }
.ct-runway-title { font-size: 44px; color: var(--ct-card); -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); white-space: nowrap; flex-shrink: 0; }
.ct-runway-score { font-size: 38px; color: var(--ct-card); white-space: nowrap; flex-shrink: 0; margin: 0 24px; }
.ct-runway-panel .ct-desk-timer { font-size: 36px; color: var(--ct-ink); background-color: var(--ct-accent); white-space: nowrap; flex-shrink: 0; padding: 12px 24px; border-radius: 20px; }
.ct-runway-panel .ct-desk-progress { height: 6px; margin-bottom: 8px; background-color: var(--ct-deep); }
.ct-runway-panel .ct-desk-progress-fill { background-color: var(--ct-game-cyan); }
.ct-runway-meta { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 4px; flex-shrink: 0; }
.ct-runway-board-title { font-size: 30px; color: var(--ct-card); -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); white-space: nowrap; flex-shrink: 0; }
.ct-runway-counter { color: var(--ct-game-blue-light); font-size: 20px; letter-spacing: 2px; white-space: nowrap; flex-shrink: 0; }
.ct-runway-instruction { font-size: 24px; color: var(--ct-game-blue-light); white-space: nowrap; flex-shrink: 0; margin-bottom: 8px; }
.ct-runway-meters { flex-direction: row; flex-shrink: 0; margin-bottom: 8px; }
.ct-runway-meter { flex-direction: row; align-items: center; flex-grow: 1; flex-basis: 0; border-left-width: 4px; border-left-color: var(--ct-control-ring-active); padding-left: 20px; }
.ct-runway-meter-label { color: var(--ct-game-blue-light); font-size: 18px; white-space: nowrap; flex-shrink: 0; margin: 0 16px 0 0; }
.ct-runway-meter-value { color: var(--ct-card); font-size: 30px; white-space: nowrap; flex-shrink: 0; -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); }
.ct-runway-met { color: var(--ct-game-green); }
.ct-runway-board { flex-direction: row; flex-grow: 1; flex-shrink: 0; min-height: 480px; padding: 12px; background-color: var(--ct-game-outline); border-width: 2px; border-bottom-width: 8px; border-color: var(--ct-control-ring-active); border-radius: 20px; margin-bottom: 12px; }
.ct-runway-strip { flex-grow: 1; flex-basis: 0; min-width: 240px; padding: 0 12px; border-right-width: 2px; border-right-color: var(--ct-control-ring-active); }
.ct-runway-last { border-right-width: 0; }
.ct-runway-line-title { color: var(--ct-card); font-size: 26px; -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); white-space: nowrap; flex-shrink: 0; margin: 0 0 8px 0; -unity-text-align: middle-center; }
.ct-runway-preset { flex-grow: 1; flex-basis: 0; min-height: 124px; min-width: 240px; margin: 0 0 8px 0; padding: 8px 20px; background-color: var(--ct-deep); border-width: 2px; border-bottom-width: 6px; border-color: var(--ct-control-ring-active); border-radius: 16px; -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); -unity-text-outline-width: 0; }
.ct-runway-preset > .ct-button-depth, .ct-runway-preset > .ct-button-glint { display: none; }
.ct-runway-preset:hover { background-color: var(--ct-deep); border-color: var(--ct-card); }
.ct-runway-preset:focus { border-width: 2px; border-bottom-width: 6px; border-color: var(--ct-card); }
.ct-runway-panel .ct-runway-preset:active { translate: 0 2px; scale: 1 1; }
.ct-runway-preset:disabled { opacity: .65; }
.ct-runway-preset.ct-runway-selected { background-color: var(--ct-accent); border-color: var(--ct-accent); opacity: 1; }
.ct-runway-preset-face { align-self: stretch; flex-shrink: 0; }
.ct-runway-preset-top { flex-direction: row; justify-content: space-between; align-items: center; min-height: 48px; flex-shrink: 0; }
.ct-runway-level { color: var(--ct-game-blue-light); font-size: 18px; white-space: nowrap; flex-shrink: 0; }
.ct-runway-lamp { width: 12px; height: 12px; border-radius: 6px; background-color: var(--ct-control-ring-active); }
.ct-runway-cost { color: var(--ct-card); font-size: 28px; margin: 0 16px; white-space: nowrap; flex-shrink: 0; -unity-text-align: middle-left; }
.ct-runway-service { color: var(--ct-game-blue-light); font-size: 18px; white-space: nowrap; flex-shrink: 0; -unity-text-align: middle-left; }
.ct-runway-selected .ct-runway-level, .ct-runway-selected .ct-runway-cost, .ct-runway-selected .ct-runway-service { color: var(--ct-ink); }
.ct-runway-selected .ct-runway-lamp { background-color: var(--ct-ink); }
.ct-runway-feedback-row { flex-direction: row; align-items: center; flex-shrink: 0; min-height: 32px; margin-bottom: 4px; }
.ct-runway-feedback { flex-grow: 1; min-width: 0; color: var(--ct-game-green); font-size: 22px; white-space: nowrap; flex-shrink: 0; }
.ct-runway-mistake { color: var(--ct-game-coral); }
.ct-runway-edits { font-size: 24px; color: var(--ct-card); white-space: nowrap; flex-shrink: 0; margin-left: 24px; }
.ct-runway-controls { flex-direction: row; align-items: center; flex-shrink: 0; }
.ct-runway-spacer { flex-grow: 1; }
.ct-runway-control { min-width: 240px; min-height: 124px; flex-shrink: 0; padding: 16px 24px; margin: 0 16px 0 0; border-width: 2px; border-color: var(--ct-control-ring-active); border-radius: 20px; background-color: var(--ct-deep); color: var(--ct-card); font-size: 26px; white-space: nowrap; -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); -unity-text-outline-width: 0; }
.ct-runway-control > .ct-button-depth { height: 8px; background-color: var(--ct-resource-depth); }
.ct-runway-control > .ct-button-glint { display: none; }
.ct-runway-control:hover { background-color: var(--ct-deep); border-color: var(--ct-card); }
.ct-runway-control:focus { border-width: 2px; border-color: var(--ct-card); }
.ct-runway-panel .ct-runway-control:active { translate: 0 4px; scale: 1 1; }
.ct-runway-primary { min-width: 360px; margin-right: 0; color: var(--ct-ink); background-color: var(--ct-accent); border-color: var(--ct-accent); }
.ct-runway-primary:hover { background-color: var(--ct-accent-hover); }
.ct-runway-end { min-width: 320px; }
.ct-runway-footnote { color: var(--ct-line); font-size: 18px; white-space: nowrap; flex-grow: 1; flex-shrink: 0; -unity-text-align: middle-right; margin: 0 24px 0 0; }
.ct-runway-paused { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--ct-scrim); border-radius: 24px; align-items: center; justify-content: center; }
.ct-runway-pause-panel { width: 1040px; padding: 40px; background-color: var(--ct-ink); border-width: 2px; border-color: var(--ct-control-ring-active); border-radius: 24px; }
.ct-runway-pause-panel .ct-desk-title { color: var(--ct-card); }
.ct-runway-pause-copy { color: var(--ct-card); font-size: 28px; white-space: normal; margin: 16px 0 32px 0; }
