/* Sleuth heat, the Steal help box, pursuits and CT Jail (backend #17, lane B 2026-10-25).
   GTA-plain per the approved brief (ct-life-evidence/heat-police-20261025/board): GTA V's objective subtitle, help box,
   WASTED band, MISSION PASSED line and timer bars, in our HUD tokens: LilitaOne display, Inter body, deep purple
   rgb(20,6,44) pills, yellow rgb(255,210,63), alarm red rgb(255,59,92). */

/* The objective subtitle and the help box moved to the design system (2026-10-27, v2): police objectives are DS toasts
   with the police mark, the steal confirm is a DS dialog through the modal host. */

/* BUSTED: GTA's WASTED band across the middle */
.heat-band {
    position: absolute; top: 40%; left: 0; right: 0; height: 170px; align-items: center; justify-content: center;
    background-color: rgba(0,0,0,0.7); opacity: 0; transition-property: opacity; transition-duration: 0.2s;
}
.heat-band.heat-in { opacity: 1; }
.heat-band-word {
    font-size: 118px; color: rgb(255,59,92); -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); letter-spacing: 6px; margin: 0; padding: 0;
    -unity-text-outline-width: 1.5px; -unity-text-outline-color: rgb(20,6,44);
}
.heat-band-sub { font-size: 22px; color: rgba(255,255,255,0.9); -unity-font-definition: url("Fonts/Phone/Inter-Bold.ttf"); letter-spacing: 3px; margin: -6px 0 0 0; padding: 0; }

/* FREE / LOST THEM: GTA's MISSION PASSED line, top centre */
.heat-passed { position: absolute; top: 22%; left: 0; right: 0; align-items: center; opacity: 0; translate: 0 10px; transition-property: opacity, translate; transition-duration: 0.22s; }
.heat-passed.heat-in { opacity: 1; translate: 0 0; }
.heat-passed-word {
    font-size: 96px; color: rgb(255,210,63); -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); letter-spacing: 4px; margin: 0; padding: 0;
    -unity-text-outline-width: 1.5px; -unity-text-outline-color: rgb(20,6,44);
}
.heat-passed-sub { font-size: 24px; color: rgb(255,255,255); -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); margin: 0; padding: 0; -unity-text-outline-width: 0.4px; -unity-text-outline-color: rgba(0,0,0,0.7); }

/* CT Jail (v2): a DS pill under the minimap (clock badge, release countdown, Bail -> the bail card). Layout only here. */
.heat-jail { position: absolute; right: 36px; top: 450px; opacity: 0; translate: 24px 0; transition-property: opacity, translate; transition-duration: 0.22s; }
.heat-jail.heat-in { opacity: 1; translate: 0 0; }
.heat-jail > .ds-badge-ic { margin: 0 14px 0 -14px; }
.heat-jail > .heat-bail-btn { margin: 0 -18px 0 20px; }
