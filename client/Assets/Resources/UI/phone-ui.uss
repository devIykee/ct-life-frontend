/* Solana Duo — a single half of a hinged device, kept inside the landscape safe area.
   Hardware is decorative. Navigation and every app remain native UI Toolkit controls.
   Palette inherits CT Life's existing game tokens; no simulated battery or network data. */
.ct-phone {
    --ct-os-ink: #151619;
    --ct-os-secondary: #6c6d72;
    --ct-os-paper: #ffffff;
    --ct-os-grouped: #f2f2f7;
    --ct-os-line: #d8d8dd;
    --ct-os-blue: #087eff;
    --ct-os-glass: rgba(255,255,255,0.28);
    --ct-os-glass-edge: rgba(255,255,255,0.65);
    --ct-os-label-shadow: rgba(0,0,0,0.55);
    --ct-os-red: #f34a45;
    --ct-os-map-green: #73b77b;
    --ct-os-map-blue: #59a4dc;
    --ct-os-input: #e7e7ec;
    --ct-os-rail-width: 124px;
    --ct-os-rail-radius: 62px;
    --ct-os-rail-gap: 20px;
    -unity-font-definition: url("Fonts/Phone/Inter-Regular.ttf");
    color: var(--ct-os-ink);
    left: 56px; right: 40px; top: 120px; bottom: 40px;
    padding: 10px 10px 10px 14px;
    background-color: var(--ct-game-outline);
    border-width: 3px; border-color: var(--ct-muted);
    border-top-left-radius: 16px; border-bottom-left-radius: 16px;
    border-top-right-radius: 48px; border-bottom-right-radius: 48px;
    overflow: visible;
}
.ct-landscape .ct-phone { width: 832px; max-width: 92%; left: auto; right: 40px; top: 24px; bottom: 24px; }
.ct-phone-glass {
    flex-grow: 1; min-height: 0; overflow: hidden;
    background-color: var(--ct-card);
    border-top-left-radius: 8px; border-bottom-left-radius: 8px;
    border-top-right-radius: 36px; border-bottom-right-radius: 36px;
}
.ct-phone-hinge {
    position: absolute; left: -10px; width: 18px; height: 52px;
    background-color: var(--ct-muted); border-width: 3px;
    border-left-color: var(--ct-line); border-right-color: var(--ct-game-outline);
    border-top-color: var(--ct-game-outline); border-bottom-color: var(--ct-game-outline);
    border-radius: 4px;
}
.ct-phone-hinge-top { top: 24px; }
.ct-phone-hinge-bottom { bottom: 24px; }
.ct-phone-side-key { position: absolute; right: -8px; top: 180px; width: 6px; height: 88px; border-radius: 3px; background-color: var(--ct-muted); }
/* Phone-local OS typography: game fonts remain on the game, never on this screen. */
.ct-phone Label, .ct-phone Button, .ct-phone TextField, .ct-phone TextElement {
    -unity-font-definition: url("Fonts/Phone/Inter-Regular.ttf");
    -unity-font-style: normal; -unity-text-outline-width: 0; letter-spacing: 0;
}
.ct-phone-status { height: 64px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 32px; }
.ct-phone .ct-phone-clock { color: var(--ct-os-ink); font-size: 23px; margin: 0; -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); }
.ct-phone-camera { position: absolute; width: 14px; height: 14px; top: 24px; left: 50%; margin-left: -7px; background-color: var(--ct-game-outline); border-radius: 7px; }
.ct-phone-device-name { flex-direction: row; align-items: center; }
.ct-phone .ct-phone-device-label { font-size: 20px; margin: 0; color: var(--ct-os-ink); -unity-font-definition: url("Fonts/Phone/Inter-Medium.ttf"); }
.ct-phone-solana-mark { width: 28px; height: 25px; flex-shrink: 0; margin-right: 12px; background-image: url("Brand/solana-logomark.png"); -unity-background-scale-mode: scale-to-fit; }
.ct-phone-bar { background-color: var(--ct-os-paper); border-bottom-width: 1px; border-bottom-color: var(--ct-os-line); padding: 0 16px; min-height: 96px; }
.ct-phone .ct-phone-title { color: var(--ct-os-ink); font-size: 34px; -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); }
.ct-phone-at-home .ct-phone-bar { display: none; }
.ct-phone-system-button { width: 88px; height: 88px; min-width: 88px; padding: 23px; margin: 0; background-color: rgba(0,0,0,0); border-width: 0; border-radius: 44px; }
.ct-phone-system-icon { width: 100%; height: 100%; color: var(--ct-os-ink); }
.ct-phone-system-button:hover { background-color: var(--ct-os-grouped); }
.ct-phone-system-button:focus { border-width: 2px; border-color: var(--ct-os-blue); }
.ct-phone-wallpaper { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; -unity-background-scale-mode: scale-and-crop; }
.ct-phone-at-home .ct-phone-wallpaper { display: flex; }
.ct-phone-at-home .ct-phone-clock, .ct-phone-at-home .ct-phone-device-label { color: var(--ct-os-paper); text-shadow: 0 1px 4px var(--ct-os-label-shadow); }
.ct-phone-home { flex-grow: 1; min-height: 0; background-color: rgba(0,0,0,0); }
.ct-phone-widgets { height: 232px; flex-shrink: 0; flex-direction: row; margin: 18px 156px 20px 32px; justify-content: space-between; }
.ct-phone-widget { width: 47.8%; height: 100%; border-radius: 36px; border-width: 1px; border-color: var(--ct-os-glass-edge); margin: 0; padding: 0; overflow: hidden; }
.ct-phone-widget-calendar { background-color: rgba(255,255,255,0.90); }
.ct-phone-widget-map { background-color: rgba(235,242,231,0.94); }
.ct-phone-widget:active { scale: 0.98 0.98; }
.ct-phone-widget:focus { border-width: 3px; border-color: var(--ct-os-blue); }
.ct-phone .ct-phone-widget-weekday { position: absolute; top: 20px; left: 22px; font-size: 22px; color: var(--ct-os-red); margin: 0; -unity-font-definition: url("Fonts/Phone/Inter-Medium.ttf"); }
.ct-phone-widget-day { position: absolute; top: 51px; left: 18px; font-size: 88px; color: var(--ct-os-ink); margin: 0; }
.ct-phone-widget-month { position: absolute; top: 147px; left: 22px; font-size: 22px; color: var(--ct-os-secondary); margin: 0; }
.ct-phone-widget-time { position: absolute; bottom: 19px; left: 22px; font-size: 21px; color: var(--ct-os-ink); margin: 0; }
.ct-phone-widget-clock { position: absolute; width: 82px; height: 82px; top: 75px; right: 19px; }
.ct-phone-widget-clock, .ct-phone-widget-map-art {
    --ct-widget-ink: var(--ct-os-ink);
    --ct-widget-paper: var(--ct-os-paper);
    --ct-widget-accent: var(--ct-os-red);
    --ct-widget-green: var(--ct-os-map-green);
    --ct-widget-blue: var(--ct-os-map-blue);
}
.ct-phone-widget-map-art { position: absolute; left: 0; top: 0; right: 0; bottom: 54px; }
.ct-phone .ct-phone-widget-map-title { position: absolute; top: 20px; left: 22px; font-size: 23px; color: var(--ct-os-ink); margin: 0; -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); }
.ct-phone-widget-map-meta { position: absolute; left: 22px; bottom: 18px; font-size: 21px; color: var(--ct-os-ink); margin: 0; }
.ct-phone-page-viewport { flex-grow: 1; min-height: 0; overflow: hidden; margin-right: 142px; }
.ct-phone-page-track { height: 100%; flex-direction: row; flex-shrink: 0; }
.ct-phone-grid.ct-phone-page { height: 100%; flex-shrink: 0; flex-direction: row; flex-wrap: wrap; align-content: flex-start; padding: 0 14px; }
.ct-phone .ct-app, .ct-landscape .ct-phone .ct-app {
    width: 25%; height: 25%; min-height: 0; flex-shrink: 0;
    align-items: center; justify-content: center; padding: 2px 4px; margin: 0;
    border-width: 0; border-radius: 24px; background-color: rgba(0,0,0,0);
}
.ct-phone .ct-app-icon { width: 96px; height: 96px; flex-shrink: 0; border-radius: 26px; border-width: 0; background-color: rgba(0,0,0,0); }
.ct-phone .ct-phone-app-art { width: 100%; height: 100%; -unity-background-scale-mode: scale-to-fit; }
.ct-phone .ct-app-label {
    width: 100%; min-width: 0; align-self: stretch; flex-shrink: 0;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-center;
    font-size: 19px; margin: 6px 0 0; color: var(--ct-os-paper);
    text-shadow: 0 1px 4px var(--ct-os-label-shadow);
}
.ct-phone .ct-app-phase {
    position: absolute; top: 4px; right: 4px; max-width: 100%;
    font-size: 17px; margin: 0; padding: 2px 6px; border-radius: 8px;
    color: var(--ct-os-secondary); background-color: var(--ct-os-paper);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ct-phone .ct-app:focus { background-color: rgba(255,255,255,0.2); }
.ct-phone .ct-app:focus .ct-app-icon { border-width: 0; }
.ct-phone .ct-app-locked .ct-app-icon { opacity: 0.65; background-color: rgba(0,0,0,0); }
.ct-phone .ct-app:hover .ct-app-icon { background-color: rgba(0,0,0,0); opacity: 0.88; }
.ct-phone .ct-app:active .ct-app-icon { scale: 0.95 0.95; }
.ct-phone-pages { height: 80px; flex-shrink: 0; flex-direction: row; justify-content: center; align-items: center; margin-right: 142px; }
.ct-phone-page-button { width: 80px; height: 80px; min-width: 80px; min-height: 80px; padding: 0; margin: 0; align-items: center; justify-content: center; border-width: 0; background-color: rgba(0,0,0,0); }
.ct-phone-page-dot { width: 10px; height: 10px; border-radius: 5px; background-color: rgba(255,255,255,0.38); }
.ct-phone-page-selected .ct-phone-page-dot { background-color: var(--ct-os-paper); }
.ct-phone-page-button:focus { border-width: 2px; border-color: var(--ct-os-paper); border-radius: 40px; }
.ct-os-glass { background-color: var(--ct-os-glass); border-width: 1.5px; border-color: var(--ct-os-glass-edge); overflow: hidden; }
/* One centered rail owns both controls; the search circle and dock share the same silhouette. */
.ct-phone-control-rail { position: absolute; width: var(--ct-os-rail-width); right: 22px; top: 0; bottom: 0; align-items: center; justify-content: center; }
.ct-phone-dock { width: 100%; height: 488px; flex-shrink: 0; padding: 16px 0; flex-direction: column; align-items: center; justify-content: space-around; border-radius: var(--ct-os-rail-radius); }
.ct-phone .ct-phone-dock .ct-app { width: 100%; height: 25%; min-height: 0; padding: 8px; }
.ct-phone .ct-phone-dock .ct-app-icon { width: 90px; height: 90px; }
.ct-phone .ct-phone-dock .ct-app-label { display: none; }
.ct-phone-search-button { width: 100%; height: var(--ct-os-rail-width); flex-shrink: 0; padding: 38px; margin: var(--ct-os-rail-gap) 0 0; border-radius: var(--ct-os-rail-radius); }
.ct-phone-search-button .ct-phone-system-icon { color: var(--ct-os-paper); }
.ct-phone-search-button:hover { background-color: rgba(255,255,255,0.4); }
.ct-phone-search-button:focus { border-width: 3px; border-color: var(--ct-os-paper); }
.ct-phone-body { background-color: var(--ct-os-grouped); }
.ct-phone-home-control { flex-shrink: 0; align-items: center; justify-content: center; height: 48px; min-height: 48px; margin: 0; padding: 0; border-width: 0; border-radius: 0; background-color: var(--ct-os-paper); }
.ct-phone-at-home .ct-phone-home-control { background-color: rgba(0,0,0,0); }
.ct-phone-home-control:hover { background-color: rgba(255,255,255,0.2); }
.ct-phone-home-control:focus { border-width: 2px; border-color: var(--ct-os-blue); }
.ct-phone-home-line { width: 144px; height: 6px; margin: 0; border-radius: 3px; background-color: var(--ct-os-ink); }
.ct-phone-at-home .ct-phone-home-line { background-color: var(--ct-os-paper); }
/* Spotlight-style app search. The live catalog and availability gates also apply here. */
.ct-phone-search-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(247,247,250,0.96); padding: 26px 24px; }
.ct-phone-search-bar { flex-direction: row; flex-shrink: 0; align-items: center; margin-bottom: 20px; }
.ct-phone-search-field { flex-grow: 1; min-width: 0; height: 80px; margin: 0; font-size: 30px; }
.ct-phone-search-field .unity-text-field__input { background-color: var(--ct-os-input); border-width: 0; border-radius: 24px; padding: 14px 20px; color: var(--ct-os-ink); -unity-font-definition: url("Fonts/Phone/Inter-Regular.ttf"); }
.ct-phone-search-cancel { height: 80px; padding: 0 16px; margin: 0; border-width: 0; background-color: rgba(0,0,0,0); color: var(--ct-os-blue); font-size: 28px; }
.ct-phone-search-results { flex-grow: 1; }
.ct-phone .ct-phone-search-result, .ct-landscape .ct-phone .ct-phone-search-result { width: 100%; height: 110px; flex-direction: row; justify-content: flex-start; padding: 12px 16px; border-radius: 24px; background-color: var(--ct-os-paper); margin-bottom: 8px; }
.ct-phone .ct-phone-search-result .ct-app-icon { width: 76px; height: 76px; }
.ct-phone .ct-phone-search-result .ct-app-label { width: auto; flex-grow: 1; align-self: center; margin: 0 0 0 24px; font-size: 28px; color: var(--ct-os-ink); -unity-text-align: middle-left; text-shadow: 0 0 0 rgba(0,0,0,0); }
.ct-phone-search-empty { font-size: 28px; color: var(--ct-os-secondary); margin: 32px 12px; }
.ct-phone-searching > .ct-phone-widgets, .ct-phone-searching > .ct-phone-page-viewport, .ct-phone-searching > .ct-phone-pages, .ct-phone-searching > .ct-phone-control-rail { visibility: hidden; }

/* Shared app chrome: one clear reading scale, white cards, restrained edge controls. */
.ct-phone .ct-app-page { padding: 24px 28px 40px; }
.ct-phone .ct-h1, .ct-phone .ct-h2, .ct-phone .ct-section-title, .ct-phone .ct-chip-title, .ct-phone .ct-venue-title, .ct-phone .ct-big-number {
    -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); -unity-text-outline-width: 0;
}
.ct-phone .ct-h1 { font-size: 40px; margin: 8px 0 24px; }
.ct-phone .ct-h2 { font-size: 32px; }
.ct-phone .ct-body { font-size: 30px; }
.ct-phone .ct-small { font-size: 26px; }
.ct-phone .ct-card, .ct-phone .ct-district, .ct-phone .ct-lb-row, .ct-phone .ct-row-btn, .ct-phone .ct-chip, .ct-phone .ct-venue {
    border-width: 1px; border-color: var(--ct-os-line); border-radius: 24px;
}
.ct-phone .ct-card { padding: 24px; background-color: var(--ct-os-paper); }
.ct-phone .ct-btn { font-size: 30px; min-height: 96px; background-color: var(--ct-os-paper); color: var(--ct-os-ink); border-width: 1px; border-color: var(--ct-os-line); -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); -unity-text-outline-width: 0; }
.ct-phone .ct-btn .ct-icon { -unity-background-image-tint-color: var(--ct-os-ink); }
.ct-phone .ct-btn-primary { background-color: var(--ct-os-blue); border-color: var(--ct-os-blue); color: var(--ct-os-paper); }
.ct-phone .ct-btn-primary:hover { opacity: 0.85; }
.ct-phone .ct-btn-danger { background-color: var(--ct-red); color: var(--ct-os-paper); }
.ct-phone .ct-btn:focus, .ct-phone .ct-row-btn:focus, .ct-phone .ct-chip:focus { border-color: var(--ct-os-blue); border-width: 3px; }
.ct-phone .ct-pressable > .ct-button-depth, .ct-phone .ct-pressable > .ct-button-glint { display: none; }
.ct-phone .ct-app-tabs { margin-bottom: 24px; }
.ct-phone .ct-app-tabs > .ct-chip { font-size: 26px; }
.ct-phone .ct-phone-bar .ct-btn-icon { background-color: rgba(0,0,0,0); border-width: 0; }
.ct-phone .ct-phone-bar .ct-btn-icon:hover { background-color: var(--ct-os-grouped); }
.ct-phone .ct-phone-bar .ct-btn-icon:focus { border-width: 3px; border-color: var(--ct-os-blue); }
.ct-phone .ct-phone-repeated-title { display: none; }
.ct-phone .ct-map > .ct-header, .ct-phone .ct-map-intro > .ct-body { display: none; }
.ct-phone .ct-map-intro { padding: 0 8px 16px; }
.ct-phone .ct-map-count { margin-top: 0; }
.ct-phone .ct-bank-hero { padding: 24px; margin-bottom: 16px; }
.ct-phone .ct-bank-hero .ct-big-number { font-size: 60px; margin: 12px 0 16px; }
.ct-phone .ctc-actions > .ctc-btn { min-width: 220px; flex-grow: 1; flex-basis: 0; }
.ct-phone .ctc-tab.ctc-selected { background-color: var(--ct-green-light); border-color: var(--ct-green); border-width: 2px; }
.ct-phone .ctc-card-title { flex-shrink: 1; min-width: 0; font-size: 32px; }
.ct-phone .ctc-card > .ctc-row { flex-wrap: wrap; }

/* Wallet holdings are separate from fictional Cash. All values and states are supplied by the service. */
.ct-wallet-summary { background-color: var(--ct-os-paper); border-width: 1px; border-color: var(--ct-os-line); border-radius: 24px; padding: 20px 24px; margin-bottom: 8px; }
.ct-wallet-network { align-self: flex-start; color: var(--ct-green); background-color: var(--ct-green-light); border-radius: 12px; padding: 8px 16px; font-size: 22px; margin-bottom: 8px; }
.ct-wallet-address { color: var(--ct-muted); font-size: 24px; white-space: normal; margin: 8px 0; }
.ct-wallet-status { font-size: 24px; white-space: normal; color: var(--ct-muted); margin: 8px 0; }
.ct-wallet-token { flex-direction: row; align-items: center; background-color: var(--ct-os-paper); border-radius: 24px; padding: 20px 24px; margin: 8px 0; border-width: 1px; border-color: var(--ct-os-line); }
.ct-wallet-symbol { width: 88px; height: 88px; border-radius: 28px; flex-shrink: 0; align-items: center; justify-content: center; margin-right: 20px; background-color: var(--ct-surface); }
.ct-wallet-symbol Label { font-size: 22px; -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); }
.ct-wallet-sol { background-color: var(--ct-game-purple); }
.ct-wallet-usdc { background-color: var(--ct-game-cyan); }
.ct-wallet-skr { background-color: var(--ct-game-green); }
.ct-wallet-ore { background-color: var(--ct-accent); }
.ct-phone .ct-wallet-name { font-size: 26px; margin: 0 0 8px; -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); }
.ct-phone .ct-wallet-amount { font-size: 34px; white-space: normal; color: var(--ct-os-ink); -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); }
.ct-wallet-stale { color: var(--ct-red); }


/* Duo app interiors — studied from the user's 2026-10-15 component references.
   Role-specific cards and real status, with enough room for touch. Home launcher is outside this scope. */
.ct-phone-body {
    --ct-duo-canvas: #f5f5f7;
    --ct-duo-paper: #ffffff;
    --ct-duo-inset: #f0f1f4;
    --ct-duo-edge: #e5e7ec;
    --ct-duo-edge-low: #dfe2e8;
    --ct-duo-ink: #202127;
    --ct-duo-muted: #70747e;
    --ct-duo-blue: #2268d8;
    --ct-duo-blue-soft: #e8f2ff;
    --ct-duo-green: #21804d;
    --ct-duo-green-soft: #e5f6eb;
    --ct-duo-amber: #93601b;
    --ct-duo-amber-soft: #fff3da;
    --ct-duo-red: #b6433c;
    --ct-duo-red-soft: #fcecea;
    --ct-duo-purple: #7448c6;
    --ct-duo-purple-soft: #efe9fc;
    --ct-duo-radius: 30px;
    --ct-duo-inset-radius: 22px;
    --ct-duo-space: 24px;
    background-color: var(--ct-duo-canvas);
}
.ct-phone .ct-phone-body .ct-app-page { padding: 20px 28px 36px; }
.ct-phone .ct-phone-body .ct-h1 { font-size: 38px; margin: 4px 0 22px; }
.ct-phone .ct-phone-body .ct-h2 { font-size: 30px; margin: 0 0 14px; color: var(--ct-duo-ink); }
.ct-phone .ct-phone-body .ct-body, .ct-phone .ct-phone-body .ctc-body-text { font-size: 28px; color: var(--ct-duo-ink); }
.ct-phone .ct-phone-body .ct-small, .ct-phone .ct-phone-body .ctc-muted { font-size: 24px; color: var(--ct-duo-muted); margin-top: 4px; margin-bottom: 12px; }
.ct-phone .ct-phone-body .ct-muted { color: var(--ct-duo-muted); }
.ct-phone .ct-phone-body .ct-section-title, .ct-phone .ct-phone-body .ctc-section { font-size: 23px; color: var(--ct-duo-muted); margin: 24px 4px 12px; letter-spacing: 0; }
.ct-phone .ct-phone-body .ct-card, .ct-phone .ct-phone-body .ctc-card {
    background-color: var(--ct-duo-paper); border-width: 1px; border-color: var(--ct-duo-edge);
    border-bottom-width: 2px; border-bottom-color: var(--ct-duo-edge-low); border-radius: var(--ct-duo-radius);
    padding: var(--ct-duo-space); margin: 10px 0 16px; flex-shrink: 0;
}
.ct-phone .ct-phone-body .ct-card .ct-card { border-radius: var(--ct-duo-inset-radius); background-color: var(--ct-duo-canvas); border-width: 0; }
.ct-phone .ct-phone-body .ct-btn {
    min-height: 92px; min-width: 92px; padding: 18px 26px; margin: 8px 0;
    font-size: 27px; color: var(--ct-duo-ink); background-color: var(--ct-duo-inset);
    border-width: 1px; border-color: var(--ct-duo-edge); border-radius: 46px;
}
.ct-phone .ct-phone-body .ct-btn-primary, .ct-phone .ct-phone-body .ctc-btn-primary {
    background-color: var(--ct-duo-blue); border-color: var(--ct-duo-blue); color: var(--ct-duo-paper);
}
.ct-phone .ct-phone-body .ct-btn-danger, .ct-phone .ct-phone-body .ctc-btn-danger {
    background-color: var(--ct-duo-red-soft); border-color: var(--ct-duo-red-soft); color: var(--ct-duo-red);
}
.ct-phone .ct-phone-body .ct-btn-ghost { color: var(--ct-duo-blue); background-color: var(--ct-duo-paper); border-color: var(--ct-duo-edge); }
.ct-phone .ct-phone-body .ct-btn:disabled { opacity: 0.42; }
.ct-phone .ct-phone-body .ct-btn:active { scale: 0.985 0.985; }
.ct-phone .ct-phone-body .ct-field { font-size: 28px; margin: 10px 0 18px; }
.ct-phone .ct-phone-body .ct-field > .unity-text-field__label { font-size: 24px; color: var(--ct-duo-muted); margin-bottom: 10px; }
.ct-phone .ct-phone-body .ct-field > .unity-text-field__input {
    min-height: 96px; background-color: var(--ct-duo-inset); border-width: 1px; border-color: var(--ct-duo-edge);
    border-radius: var(--ct-duo-inset-radius); padding: 20px; font-size: 28px; color: var(--ct-duo-ink);
}
.ct-phone .ct-phone-body .ct-field > .unity-text-field__input:focus { border-color: var(--ct-duo-blue); border-width: 2px; }
.ct-phone .ct-phone-body .ct-chip {
    min-height: 88px; min-width: 88px; padding: 16px 20px; margin: 4px; font-size: 24px;
    background-color: var(--ct-duo-paper); border-width: 1px; border-color: var(--ct-duo-edge);
    border-radius: 44px; color: var(--ct-duo-muted); align-items: center; justify-content: center;
}
.ct-phone .ct-phone-body .ct-chip-on { color: var(--ct-duo-blue); background-color: var(--ct-duo-blue-soft); border-color: var(--ct-duo-blue-soft); }
.ct-phone .ct-phone-body .ct-app-tabs, .ct-phone .ct-phone-body .ctc-tabs, .ct-phone .ct-phone-body .ct-duo-segment {
    flex-direction: row; align-items: center; flex-wrap: wrap; padding: 6px; margin: 6px 0 22px;
    border-width: 1px; border-color: var(--ct-duo-edge); border-radius: 50px; background-color: var(--ct-duo-inset);
}
.ct-phone .ct-phone-body .ct-app-tabs > .ct-chip, .ct-phone .ct-phone-body .ctc-tabs > .ctc-tab,
.ct-phone .ct-phone-body .ct-duo-segment > .ct-chip {
    flex-grow: 1; flex-basis: 0; min-width: 116px; min-height: 80px; padding: 14px 12px; margin: 0;
    border-width: 0; background-color: rgba(0,0,0,0); border-radius: 40px; color: var(--ct-duo-muted); font-size: 24px;
}
.ct-phone .ct-phone-body .ct-app-tabs > .ct-chip-on, .ct-phone .ct-phone-body .ctc-tabs > .ctc-selected,
.ct-phone .ct-phone-body .ct-duo-segment > .ct-chip-on {
    background-color: var(--ct-duo-paper); color: var(--ct-duo-ink); border-width: 1px; border-color: var(--ct-duo-edge-low);
}
/* Semantic colour belongs to a status, never to a random container. */
.ct-phone-body .ct-duo-tone-neutral { --ct-duo-tone: var(--ct-duo-muted); --ct-duo-tone-soft: var(--ct-duo-inset); }
.ct-phone-body .ct-duo-tone-info { --ct-duo-tone: var(--ct-duo-blue); --ct-duo-tone-soft: var(--ct-duo-blue-soft); }
.ct-phone-body .ct-duo-tone-success { --ct-duo-tone: var(--ct-duo-green); --ct-duo-tone-soft: var(--ct-duo-green-soft); }
.ct-phone-body .ct-duo-tone-warning { --ct-duo-tone: var(--ct-duo-amber); --ct-duo-tone-soft: var(--ct-duo-amber-soft); }
.ct-phone-body .ct-duo-tone-danger { --ct-duo-tone: var(--ct-duo-red); --ct-duo-tone-soft: var(--ct-duo-red-soft); }
.ct-phone-body .ct-duo-tone-accent { --ct-duo-tone: var(--ct-duo-purple); --ct-duo-tone-soft: var(--ct-duo-purple-soft); }
.ct-phone .ct-phone-body .ct-duo-status {
    align-self: flex-start; flex-direction: row; align-items: center; flex-shrink: 0; max-width: 100%;
    padding: 10px 16px; margin: 0 8px 14px 0; border-radius: 16px; background-color: var(--ct-duo-tone-soft); color: var(--ct-duo-tone);
}
.ct-phone .ct-phone-body .ct-duo-status-glyph { width: 27px; height: 27px; margin-right: 10px; flex-shrink: 0; color: var(--ct-duo-tone); }
.ct-phone .ct-phone-body .ct-duo-status-label { min-width: 0; flex-shrink: 1; white-space: normal; font-size: 23px; color: var(--ct-duo-tone); margin: 0; -unity-font-definition: url("Fonts/Phone/Inter-Medium.ttf"); }
.ct-phone .ct-phone-body .ct-duo-metrics { flex-direction: row; flex-wrap: wrap; margin: 0 -6px 12px; }
.ct-phone .ct-phone-body .ct-duo-metric {
    flex-grow: 0; min-width: 0; border-radius: var(--ct-duo-inset-radius); padding: 22px;
    margin: 6px; background-color: var(--ct-duo-tone-soft); flex-shrink: 0;
}
.ct-phone .ct-phone-body .ct-duo-metrics > .ct-duo-metric { flex-grow: 1; flex-basis: 42%; min-width: 240px; }
.ct-phone .ct-phone-body .ct-duo-metric-heading { flex-direction: row; align-items: center; margin-bottom: 16px; }
.ct-phone .ct-phone-body .ct-duo-metric-heading .ct-icon { width: 28px; height: 28px; flex-shrink: 0; margin-right: 10px; -unity-background-image-tint-color: var(--ct-duo-tone); }
.ct-phone .ct-phone-body .ct-duo-metric-label { flex-shrink: 1; min-width: 0; white-space: normal; font-size: 24px; color: var(--ct-duo-ink); margin: 0; }
.ct-phone .ct-phone-body .ct-duo-metric-value { font-size: 40px; color: var(--ct-duo-ink); margin: 0; white-space: normal; -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); }
.ct-phone .ct-phone-body .ct-duo-caption { font-size: 23px; white-space: normal; color: var(--ct-duo-muted); margin: 10px 0 0; }
.ct-phone .ct-phone-body .ct-duo-state-panel { background-color: var(--ct-duo-paper); border-radius: var(--ct-duo-radius); border-width: 1px; border-color: var(--ct-duo-edge); padding: 26px; margin: 12px 0; flex-shrink: 0; }
.ct-phone .ct-phone-body .ct-duo-state-body { font-size: 27px; color: var(--ct-duo-ink); white-space: normal; margin: 0; }
.ct-phone .ct-phone-body .ct-duo-card-footer { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 22px; padding-top: 14px; border-top-width: 1px; border-top-color: var(--ct-duo-edge); }
.ct-phone .ct-phone-body .ct-duo-card-footer > .ct-btn { flex-grow: 1; flex-basis: 0; margin: 6px; }
.ct-phone .ct-phone-body .ct-duo-card-footer > .ct-small { flex-grow: 1; flex-shrink: 1; min-width: 180px; margin-right: 12px; }
.ct-phone .ct-phone-body .ct-duo-card-kicker { font-size: 22px; color: var(--ct-duo-muted); margin: 0 0 10px; }
.ct-phone .ct-phone-body .ct-duo-card-title { font-size: 32px; color: var(--ct-duo-ink); margin: 0 0 12px; white-space: normal; -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); }
/* Cash is intentionally distinct from connected wallet holdings. */
.ct-phone .ct-phone-body .ct-bank-hero { background-color: var(--ct-duo-paper); border-radius: var(--ct-duo-radius); border-width: 1px; border-color: var(--ct-duo-edge); padding: 28px; margin-bottom: 12px; }
.ct-phone .ct-phone-body .ct-bank-hero .ct-big-number { font-size: 64px; margin: 8px 0 12px; }
.ct-phone .ct-phone-body .ct-bank-hero .ct-eyebrow { font-size: 24px; color: var(--ct-duo-muted); letter-spacing: 0; }
.ct-phone .ct-phone-body .ct-duo-balance-heading { flex-direction: row; align-items: center; }
.ct-phone .ct-phone-body .ct-duo-balance-heading .ct-icon { width: 34px; height: 34px; margin-right: 12px; -unity-background-image-tint-color: var(--ct-duo-blue); }
.ct-phone .ct-phone-body .ct-duo-bank-debt { margin-top: 18px; padding-top: 18px; border-top-width: 1px; border-top-color: var(--ct-duo-edge); }
.ct-phone .ct-phone-body .ct-duo-bank-debt .ct-duo-status { margin-bottom: 0; }
.ct-phone .ct-phone-body .ct-duo-pack { flex-direction: row; align-items: center; }
.ct-phone .ct-phone-body .ct-duo-pack-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 24px; }
.ct-phone .ct-phone-body .ct-duo-pack-copy .ct-h2 { margin-bottom: 8px; }
.ct-phone .ct-phone-body .ct-duo-pack .ct-btn { min-width: 150px; }
.ct-phone .ct-phone-body .ct-duo-pack-copy .ct-duo-status { margin: 0 0 12px; }
.ct-phone .ct-phone-body .ct-money-notice { border-width: 0; border-radius: var(--ct-duo-inset-radius); background-color: var(--ct-duo-blue-soft); color: var(--ct-duo-blue); font-size: 25px; padding: 22px; }
.ct-phone .ct-phone-body .ct-money-notice-warn { background-color: var(--ct-duo-amber-soft); color: var(--ct-duo-amber); }
.ct-phone .ct-phone-body .ct-money-notice-error { background-color: var(--ct-duo-red-soft); color: var(--ct-duo-red); }
.ct-phone .ct-phone-body .ct-money-value { -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); font-size: 28px; }
.ct-phone .ct-phone-body .ct-money-key { font-size: 25px; }
/* Jobs retain every action and gate, but status, role, pay and secondary action have distinct places. */
.ct-phone .ct-phone-body .ctc-hired { border-width: 1px; border-color: var(--ct-duo-edge); border-bottom-width: 2px; border-bottom-color: var(--ct-duo-edge-low); }
.ct-phone .ct-phone-body .ctc-card-title { font-size: 32px; margin-bottom: 12px; -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); }
.ct-phone .ct-phone-body .ctc-card .ctc-actions { border-top-width: 1px; border-top-color: var(--ct-duo-edge); padding-top: 14px; margin-top: 18px; }
.ct-phone .ct-phone-body .ctc-actions > .ctc-btn { min-width: 160px; margin: 6px; }
.ct-phone .ct-phone-body .ctc-title { font-size: 36px; -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); }
.ct-phone .ct-phone-body .ct-duo-pay-line { color: var(--ct-duo-ink); font-size: 29px; -unity-font-definition: url("Fonts/Phone/Inter-Medium.ttf"); margin: 6px 0 12px; white-space: normal; }

.ct-phone .ct-phone-body .ct-duo-needs .ct-duo-need { min-width: 220px; padding: 20px; }
.ct-phone .ct-phone-body .ct-duo-needs .ct-duo-metric-heading { margin-bottom: 10px; }
.ct-phone .ct-phone-body .ct-duo-needs .ct-duo-need-track { margin-top: 16px; border-radius: 5px; overflow: hidden; }
.ct-phone .ct-phone-body .ct-duo-needs-actions { flex-direction: row; flex-wrap: wrap; padding-top: 16px; border-top-width: 1px; border-top-color: var(--ct-duo-edge); }
.ct-phone .ct-phone-body .ct-duo-needs-actions > .ct-btn { min-width: 220px; flex-grow: 1; flex-basis: 42%; margin: 6px; }

.ct-phone .ct-phone-body .ct-badge { background-color: var(--ct-duo-inset); color: var(--ct-duo-muted); border-width: 0; border-radius: 16px; padding: 8px 14px; font-size: 22px; align-self: flex-start; white-space: normal; }
.ct-phone .ct-phone-body .ct-btn:focus, .ct-phone .ct-phone-body .ct-chip:focus { border-width: 2px; border-color: var(--ct-duo-blue); }
