/* Solana Duo — a single half of a hinged device, kept inside the landscape safe area.
   Hardware is decorative. Navigation and every app remain native UI Toolkit controls.
   Palette inherits CT Life's existing game tokens; no simulated battery or network data. */
.ct-phone {
    left: 56px; right: 40px; top: 120px; bottom: 40px;
    padding: 10px 10px 10px 14px;
    background-color: var(--ct-game-outline);
    border-width: 3px; border-color: var(--ct-muted);
    border-top-left-radius: 16px; border-bottom-left-radius: 16px;
    border-top-right-radius: 48px; border-bottom-right-radius: 48px;
    overflow: visible;
}
.ct-landscape .ct-phone { width: 832px; max-width: 92%; left: auto; right: 40px; top: 24px; bottom: 24px; }
.ct-phone-glass {
    flex-grow: 1; min-height: 0; overflow: hidden;
    background-color: var(--ct-card);
    border-top-left-radius: 8px; border-bottom-left-radius: 8px;
    border-top-right-radius: 36px; border-bottom-right-radius: 36px;
}
.ct-phone-hinge {
    position: absolute; left: -10px; width: 18px; height: 52px;
    background-color: var(--ct-muted); border-width: 3px;
    border-left-color: var(--ct-line); border-right-color: var(--ct-game-outline);
    border-top-color: var(--ct-game-outline); border-bottom-color: var(--ct-game-outline);
    border-radius: 4px;
}
.ct-phone-hinge-top { top: 24px; }
.ct-phone-hinge-bottom { bottom: 24px; }
.ct-phone-side-key { position: absolute; right: -8px; top: 180px; width: 6px; height: 88px; border-radius: 3px; background-color: var(--ct-muted); }
.ct-phone-status { height: 52px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 32px; }
.ct-phone-clock { color: var(--ct-ink); font-size: 22px; margin: 0; -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); }
.ct-phone-camera { position: absolute; width: 14px; height: 14px; top: 18px; left: 50%; margin-left: -7px; background-color: var(--ct-game-outline); border-radius: 7px; }
.ct-phone-emblem { width: 24px; height: 20px; justify-content: space-between; }
.ct-phone-stripe { height: 4px; background-color: var(--ct-violet); border-radius: 2px; translate: 3px 0; }
.ct-phone-stripe-middle { background-color: var(--ct-green); translate: 0 0; }
.ct-phone-bar { background-color: var(--ct-card); border-bottom-width: 1px; border-bottom-color: var(--ct-line); padding: 0 8px; min-height: 124px; }
.ct-phone-title { color: var(--ct-ink); font-size: 36px; -unity-text-outline-width: 0; -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); }
.ct-phone-at-home .ct-phone-title { margin-left: 24px; font-size: 42px; }
.ct-phone-bar .ct-btn-icon { min-height: 124px; height: 124px; min-width: 124px; width: 124px; margin: 0; padding: 38px; border-width: 0; border-radius: 24px; background-color: rgba(0,0,0,0); }
.ct-phone-bar .ct-btn-icon .ct-icon { width: 44px; height: 44px; -unity-background-image-tint-color: var(--ct-ink); }
.ct-phone-bar .ct-btn-icon:hover { background-color: var(--ct-bg); }
.ct-phone-bar .ct-btn-icon:focus { border-width: 3px; border-color: var(--ct-deep); }
.ct-phone-home { background-color: var(--ct-card); }
.ct-phone-section { margin: 24px 32px 8px; font-size: 22px; color: var(--ct-muted); -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); }
.ct-phone-grid { padding: 24px 16px 16px; }
.ct-phone-grid-later { padding-top: 0; }
.ct-phone .ct-app, .ct-landscape .ct-phone .ct-app { width: 33.3333%; min-height: 204px; padding: 16px 8px; margin: 0; border-width: 0; background-color: rgba(0,0,0,0); }
.ct-phone .ct-app-icon { width: 112px; height: 112px; border-radius: 28px; border-width: 0; background-color: var(--ct-surface); }
.ct-phone .ct-app-icon.ct-tone-cyan { background-color: var(--ct-game-cyan); }
.ct-phone .ct-app-icon.ct-tone-coral { background-color: var(--ct-game-coral); }
.ct-phone .ct-app-icon.ct-tone-gold { background-color: var(--ct-accent); }
.ct-phone .ct-app-icon.ct-tone-violet { background-color: var(--ct-game-purple); }
.ct-phone .ct-app-icon.ct-tone-green { background-color: var(--ct-game-green); }
.ct-phone .ct-app-icon .ct-icon { width: 60px; height: 60px; -unity-background-image-tint-color: var(--ct-ink); }
/* Use the tile's available width, not the glyph's rounded intrinsic measurement on Android. */
.ct-phone .ct-app-label {
    width: 100%; min-width: 0; align-self: stretch; flex-shrink: 0;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-center;
    font-size: 26px; margin-top: 12px; color: var(--ct-ink); -unity-font-definition: url("Fonts/Manrope-Semibold.ttf");
}
.ct-phone .ct-app-phase { font-size: 21px; margin-top: 4px; }
.ct-phone .ct-app:focus .ct-app-icon { border-width: 3px; border-color: var(--ct-deep); }
.ct-phone .ct-app-locked .ct-app-icon { background-color: var(--ct-bg); }
.ct-phone .ct-app-locked .ct-app-icon .ct-icon { -unity-background-image-tint-color: var(--ct-muted); }
.ct-phone .ct-app-locked .ct-app-label { color: var(--ct-muted); }
.ct-phone .ct-app:hover .ct-app-icon { opacity: 0.8; }
.ct-phone-body { background-color: var(--ct-bg); }
.ct-phone-home-control {
    flex-shrink: 0; align-items: center; justify-content: center;
    height: 124px; min-height: 124px; margin: 0; padding: 0;
    border-width: 0; border-radius: 0; background-color: var(--ct-card);
}
.ct-phone-home-control:hover { background-color: var(--ct-bg); }
.ct-phone-home-control:focus { border-width: 3px; border-color: var(--ct-deep); }
.ct-phone-home-line { width: 144px; height: 6px; margin: 0; border-radius: 3px; background-color: var(--ct-ink); }

/* Shared app chrome: one clear reading scale, white cards, restrained edge controls. */
.ct-phone .ct-app-page { padding: 24px 28px 40px; }
.ct-phone .ct-h1, .ct-phone .ct-h2, .ct-phone .ct-section-title, .ct-phone .ct-chip-title, .ct-phone .ct-venue-title, .ct-phone .ct-big-number {
    -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); -unity-text-outline-width: 0;
}
.ct-phone .ct-h1 { font-size: 40px; margin: 8px 0 24px; }
.ct-phone .ct-h2 { font-size: 32px; }
.ct-phone .ct-body { font-size: 30px; }
.ct-phone .ct-small { font-size: 26px; }
.ct-phone .ct-card, .ct-phone .ct-district, .ct-phone .ct-lb-row, .ct-phone .ct-row-btn, .ct-phone .ct-chip, .ct-phone .ct-venue {
    border-width: 1px; border-color: var(--ct-line); border-radius: 24px;
}
.ct-phone .ct-card { padding: 24px; background-color: var(--ct-card); }
.ct-phone .ct-btn { font-size: 30px; min-height: 124px; background-color: var(--ct-card); color: var(--ct-ink); border-width: 1px; border-color: var(--ct-line); -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); -unity-text-outline-width: 0; }
.ct-phone .ct-btn .ct-icon { -unity-background-image-tint-color: var(--ct-ink); }
.ct-phone .ct-btn-primary { background-color: var(--ct-accent); border-color: var(--ct-accent); color: var(--ct-ink); }
.ct-phone .ct-btn-primary:hover { background-color: var(--ct-accent-hover); }
.ct-phone .ct-btn-danger { background-color: var(--ct-red); color: var(--ct-card); }
.ct-phone .ct-btn:focus, .ct-phone .ct-row-btn:focus, .ct-phone .ct-chip:focus { border-color: var(--ct-deep); border-width: 3px; }
.ct-phone .ct-pressable > .ct-button-depth, .ct-phone .ct-pressable > .ct-button-glint { display: none; }
.ct-phone .ct-app-tabs { margin-bottom: 24px; }
.ct-phone .ct-app-tabs > .ct-chip { font-size: 26px; }
.ct-phone .ct-phone-bar .ct-btn-icon { background-color: rgba(0,0,0,0); border-width: 0; }
.ct-phone .ct-phone-bar .ct-btn-icon:hover { background-color: var(--ct-bg); }
.ct-phone .ct-phone-bar .ct-btn-icon:focus { border-width: 3px; border-color: var(--ct-deep); }
.ct-phone .ct-phone-repeated-title { display: none; }
.ct-phone .ct-map > .ct-header, .ct-phone .ct-map-intro > .ct-body { display: none; }
.ct-phone .ct-map-intro { padding: 0 8px 16px; }
.ct-phone .ct-map-count { margin-top: 0; }
.ct-phone .ct-bank-hero { padding: 24px; margin-bottom: 16px; }
.ct-phone .ct-bank-hero .ct-big-number { font-size: 60px; margin: 12px 0 16px; }
.ct-phone .ctc-actions > .ctc-btn { min-width: 220px; flex-grow: 1; flex-basis: 0; }
.ct-phone .ctc-tab.ctc-selected { background-color: var(--ct-green-light); border-color: var(--ct-green); border-width: 2px; }
.ct-phone .ctc-card-title { flex-shrink: 1; min-width: 0; font-size: 32px; }
.ct-phone .ctc-card > .ctc-row { flex-wrap: wrap; }

/* Wallet holdings are separate from fictional Cash. All values and states are supplied by the service. */
.ct-wallet-summary { background-color: var(--ct-card); border-width: 1px; border-color: var(--ct-line); border-radius: 24px; padding: 20px 24px; margin-bottom: 8px; }
.ct-wallet-network { align-self: flex-start; color: var(--ct-green); background-color: var(--ct-green-light); border-radius: 12px; padding: 8px 16px; font-size: 22px; margin-bottom: 8px; }
.ct-wallet-address { color: var(--ct-muted); font-size: 24px; white-space: normal; margin: 8px 0; }
.ct-wallet-status { font-size: 24px; white-space: normal; color: var(--ct-muted); margin: 8px 0; }
.ct-wallet-token { flex-direction: row; align-items: center; background-color: var(--ct-card); border-radius: 24px; padding: 20px 24px; margin: 8px 0; border-width: 1px; border-color: var(--ct-line); }
.ct-wallet-symbol { width: 88px; height: 88px; border-radius: 28px; flex-shrink: 0; align-items: center; justify-content: center; margin-right: 20px; background-color: var(--ct-surface); }
.ct-wallet-symbol Label { font-size: 22px; -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); }
.ct-wallet-sol { background-color: var(--ct-game-purple); }
.ct-wallet-usdc { background-color: var(--ct-game-cyan); }
.ct-wallet-skr { background-color: var(--ct-game-green); }
.ct-wallet-ore { background-color: var(--ct-accent); }
.ct-wallet-name { font-size: 26px; margin: 0 0 8px; -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); }
.ct-wallet-amount { font-size: 34px; white-space: normal; color: var(--ct-ink); -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); }
.ct-wallet-stale { color: var(--ct-red); }
