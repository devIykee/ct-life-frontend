/* First-time flow (LotteryScreen, CharacterCreatorScreen), redesign 2026-10-08. Spec: docs/research/duolingo-design-teardown.md.
   Layout for the 2400 x 1080-unit landscape panel (Seeker 2670 x 1200). Content box: 72 units in from the sides (the safe
   margin), 22 from the top, 30 from the bottom, so 2256 x 1028. Zones: the character on the left, one question and its
   choices on the right, the CTA always bottom-right with its hint above it, the back button and progress bar on top.
   Text sits straight on the blurred painting: white Lilita with a thick plum outline and a drop, never a plate. */

.ob-screen { background-color: rgba(0, 0, 0, 0); overflow: visible; }
.ob-bg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }
.ob-content { position: absolute; left: 72px; right: 72px; top: 22px; bottom: 30px; }
.ob-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.ob-topbar { position: absolute; left: 72px; right: 72px; top: 22px; height: 140px; flex-direction: row; align-items: center; }
.ob-topbar > .kit-progress { margin-left: 40px; margin-top: -8px; }

.ob-cta-zone { position: absolute; right: 72px; bottom: 30px; align-items: flex-end; }
.ob-cta-zone--hidden { display: none; }
.ob-hint {
    display: none; margin: 0 6px 10px 0; padding: 0;
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 42px; -unity-text-align: middle-right; white-space: nowrap;
    color: rgb(255, 255, 255); -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(58, 20, 64);
    text-shadow: 0 3px 4px rgba(26, 8, 32, 0.85);
}
.ob-hint--on { display: flex; }

/* ------------------------------------------------------------------ type on the painting */

.ob-eyebrow, .ob-title, .ob-sub, .ob-line, .ob-note, .ob-look-name, .ob-look-count,
.ob-drag-hint, .ob-alias-status, .ob-celebrate-title, .ob-celebrate-sub, .ob-card-odds, .ob-card-fallback {
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); color: rgb(255, 255, 255); margin: 0; padding: 0;
    -unity-text-outline-color: rgb(58, 20, 64); white-space: normal;
}
.ob-eyebrow { font-size: 40px; letter-spacing: 4px; -unity-text-outline-width: 3px; text-shadow: 0 3px 4px rgba(26, 8, 32, 0.85); }
.ob-title { font-size: 84px; -unity-text-outline-width: 5px; text-shadow: 0 6px 1px rgb(58, 20, 64); }
.ob-sub { font-size: 44px; -unity-text-outline-width: 3px; text-shadow: 0 3px 4px rgba(26, 8, 32, 0.85); margin-left: 28px; flex-shrink: 1; }
.ob-line { font-size: 50px; -unity-text-outline-width: 4px; text-shadow: 0 4px 3px rgba(26, 8, 32, 0.85); margin-top: 14px; }
.ob-note { font-size: 40px; -unity-text-outline-width: 3px; text-shadow: 0 3px 4px rgba(26, 8, 32, 0.85); }
.ob-error {
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 44px; white-space: normal; margin: 18px 0 0 0;
    color: rgb(255, 216, 216); -unity-text-outline-width: 4px; -unity-text-outline-color: rgb(110, 12, 36);
    text-shadow: 0 3px 4px rgba(26, 8, 32, 0.85);
}

/* ------------------------------------------------------------------ lottery */

/* Both the automatic draw and the unfolded card are centred in the same content box. */
.ob-lottery-table { position: absolute; left: 0; right: 0; top: 150px; height: 760px; }
.ob-lottery-status { position: absolute; left: 0; right: 660px; bottom: 0; }
.ob-lottery-status > .ob-line, .ob-lottery-status > .ob-error { margin: 0; }
.ob-lottery-status--recorded { right: 0; top: 240px; bottom: 180px; align-items: center; justify-content: center; }
.ob-lottery-status--recorded > .ob-error { margin-top: 32px; max-width: 1600px; -unity-text-align: middle-center; }
.ob-lottery-recorded { font-size: 70px; -unity-text-align: middle-center; }

.ob-card { position: absolute; top: 14px; transition-property: scale; transition-duration: 0.12s; transition-timing-function: ease-out; }
.ob-card--hot { scale: 1.05 1.05; }
.ob-card-glow {
    position: absolute; left: -240px; right: -240px; top: -240px; bottom: -240px; opacity: 0;
    -unity-background-scale-mode: stretch-to-fill; -unity-background-image-tint-color: rgb(255, 206, 72);
    transition-property: opacity; transition-duration: 0.1s;
}
.ob-card--hot > .ob-card-glow { opacity: 1; }
.ob-card--face > .ob-card-glow { opacity: 0.9; }
.ob-card-art { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; align-items: center; justify-content: center; }
.ob-card-art--plain {
    background-color: rgb(110, 58, 170); border-width: 12px; border-color: rgb(58, 20, 64); border-radius: 46px;
}
.ob-card-fallback { font-size: 60px; -unity-text-align: middle-center; -unity-text-outline-width: 5px; padding: 0 30px; }

/* Rarity ribbon on each face-down card (RARE · 20%), solid pill overlapping the card's bottom edge. */
.ob-card-ribbon { position: absolute; left: -60px; right: -60px; bottom: -40px; align-items: center; }
.ob-card-odds {
    font-size: 40px; letter-spacing: 2px; color: rgb(58, 20, 64); -unity-text-outline-width: 0; text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    padding: 8px 32px 12px 32px; border-width: 6px; border-color: rgb(58, 20, 64); border-radius: 34px;
    background-color: rgb(120, 205, 255); white-space: nowrap;
}
.ob-card--rare .ob-card-odds { background-color: rgb(255, 200, 60); }
.ob-card--seeker .ob-card-odds { background-color: rgb(186, 132, 255); }

/* The unfolded landscape origin card (widths, padding and border animate inline in LotteryScreen.SetWide). */
.ob-card--wide { flex-direction: row; border-radius: 56px; border-color: rgb(120, 205, 255); }
.ob-card--wide.ob-card--rare { border-color: rgb(255, 200, 60); }
.ob-card--wide.ob-card--seeker { border-color: rgb(186, 132, 255); }
.ob-origin-info { flex-grow: 1; flex-shrink: 1; margin-left: 50px; padding: 18px 20px 0 0; justify-content: space-between; overflow: hidden; }
.ob-origin-head { flex-shrink: 1; }
.ob-origin-top { flex-direction: row; align-items: center; }
.ob-origin-rarity, .ob-origin-chance, .ob-origin-name, .ob-origin-line, .ob-origin-label, .ob-origin-value,
.ob-origin-alias, .ob-origin-perk, .ob-origin-note {
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); color: rgb(255, 255, 255); margin: 0; padding: 0;
    -unity-text-outline-width: 0; white-space: nowrap;
}
.ob-origin-rarity {
    font-size: 36px; letter-spacing: 3px; color: rgb(58, 20, 64); padding: 6px 26px 9px 26px; border-radius: 26px;
    background-color: rgb(120, 205, 255);
}
.ob-card--rare .ob-origin-rarity { background-color: rgb(255, 200, 60); }
.ob-card--seeker .ob-origin-rarity { background-color: rgb(186, 132, 255); }
.ob-origin-chance { font-size: 38px; color: rgb(206, 186, 236); margin-left: 24px; }
.ob-origin-alias { font-size: 32px; color: rgb(206, 186, 236); margin-top: 12px; }
.ob-origin-name {
    font-size: 92px; margin-top: 10px; -unity-text-outline-width: 6px; -unity-text-outline-color: rgb(22, 6, 28);
    text-shadow: 0 7px 1px rgb(22, 6, 28);
}
.ob-origin-line { font-size: 40px; color: rgb(236, 226, 255); margin-top: 8px; white-space: normal; }
.ob-origin-perk { font-size: 34px; color: rgb(236, 226, 255); margin-top: 12px; white-space: normal; }
.ob-origin-benefits { flex-shrink: 0; }
.ob-origin-stats { flex-direction: row; padding-top: 24px; border-top-width: 3px; border-color: rgb(76, 40, 88); }
.ob-origin-stat { flex-grow: 1; flex-basis: 0; padding: 0 30px; justify-content: flex-start; }
.ob-origin-stat--cash { padding-left: 0; }
.ob-origin-stat--sep { border-left-width: 4px; border-color: rgb(76, 40, 88); }
.ob-origin-label { font-size: 30px; letter-spacing: 3px; color: rgb(190, 166, 216); }
.ob-origin-value { font-size: 64px; margin-top: 6px; }
.ob-origin-value--cash { color: rgb(20, 241, 149); }
.ob-origin-value--debt { color: rgb(255, 166, 80); }
.ob-origin-value--home { font-size: 44px; white-space: normal; }
.ob-origin-note { font-size: 30px; color: rgb(190, 166, 216); margin-top: 16px; white-space: normal; }

/* ------------------------------------------------------------------ creator: the character */

.ob-dim { position: absolute; left: -200px; right: -200px; top: -200px; bottom: -200px; background-color: rgba(30, 10, 40, 0); }

.ob-stage {
    position: absolute; left: 0; top: 330px; width: 520px; height: 698px;
    transition-property: left, top, width, height; transition-duration: 0.36s; transition-timing-function: ease-out-cubic;
}
.ob-mode-look .ob-stage { left: -50px; top: 60px; width: 1000px; height: 820px; overflow: visible; }
.ob-mode-custom .ob-stage { left: -100px; width: 900px; }
.ob-mode-side .ob-stage { left: -72px; right: -72px; top: -22px; bottom: -30px; width: auto; height: auto; transition-duration: 0s; }
.ob-mode-side .ob-stage-model { -unity-background-scale-mode: stretch-to-fill; }
.ob-screen.ob-mode-confirm .ob-stage { left: 0; top: 0; width: 1px; height: 1px; opacity: 0; } /* the RT feeds the player card */
.ob-screen.ob-typing .ob-stage { left: 0; top: 0; right: auto; bottom: auto; width: 340px; height: 330px; }
.ob-screen.ob-typing .ob-stage-model { -unity-background-scale-mode: scale-to-fit; }
.ob-screen.ob-mode-celebrate .ob-stage { left: 760px; top: 330px; width: 736px; height: 698px; }
.ob-stage-glow {
    position: absolute; left: -40%; right: -40%; top: -16%; bottom: -6%; opacity: 0.75;
    -unity-background-scale-mode: stretch-to-fill; -unity-background-image-tint-color: rgb(255, 250, 240);
}
.ob-stage-shadow {
    position: absolute; left: 30%; right: 30%; bottom: 3%; height: 5%; border-radius: 40px;
    background-color: rgba(58, 20, 64, 0.42);
}
.ob-stage--face .ob-stage-shadow, .ob-typing .ob-stage-shadow { display: none; }
.ob-stage-model { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-to-fit; }
.ob-mode-look .ob-stage-model { top: -50px; bottom: -50px; }
.ob-drag-hint {
    position: absolute; left: 0; right: 0; bottom: -6px; font-size: 40px; -unity-text-align: middle-center;
    -unity-text-outline-width: 3px; text-shadow: 0 3px 4px rgba(26, 8, 32, 0.85);
}
.ob-mode-side .ob-drag-hint { display: none; }
.ob-mode-look .ob-drag-hint { display: none; }
.ob-stage-missing { position: absolute; left: 0; right: 0; top: 40%; align-items: center; }

.ob-bubble { left: 0; top: 150px; max-width: 520px; }
.ob-mode-side .ob-bubble { display: none; }
.ob-mode-look .ob-bubble { display: none; }
.ob-mode-confirm .ob-bubble { display: none; }
.ob-screen.ob-mode-celebrate .ob-bubble { left: 1250px; top: 380px; max-width: 560px; }
.ob-typing .ob-bubble { display: none; }

/* Look step: big painted arrows either side, the look's name underneath. */
.ob-look-controls { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.ob-look-label { position: absolute; left: 50px; width: 800px; top: 930px; flex-direction: row; justify-content: center; align-items: center; }
.ob-mode-custom .ob-look-label { left: 0; width: 700px; }
/* Full body / face zoom belongs to the model, so it sits on the model's left (user review 2026-10-10). */
.ob-zoom-col { position: absolute; left: 0; top: 440px; }
.ob-mode-custom .ob-zoom-col { left: 0; }
.ob-zoom { margin-bottom: 18px; }
.ob-preview-tool {
    width: 100px; height: 100px; margin: 0; padding: 22px; border-width: 2px; border-color: rgba(255, 255, 255, 0.35);
    border-radius: 28px; background-color: rgba(58, 20, 64, 0.36); align-items: center; justify-content: center;
}
.ob-preview-tool:hover, .ob-preview-tool:focus { background-color: rgba(146, 88, 220, 0.65); }
.ob-preview-tool:active { background-color: rgb(110, 58, 170); }
.ob-preview-tool .ct-icon { width: 50px; height: 50px; -unity-background-image-tint-color: rgb(255, 255, 255); }
.ob-zoom.ob-seg--on { border-color: rgb(255, 255, 255); background-color: rgba(146, 88, 220, 0.65); }
.ob-likeness-edit { margin-left: 24px; padding: 12px 22px 25px 22px; }
.ob-edit-paid { position: absolute; bottom: 6px; left: 0; right: 0; font-size: 22px; color: rgb(255, 212, 84); -unity-text-align: middle-center; }
.ob-mode-confirm .ob-look-controls { display: none; }
.ob-look-name { font-size: 66px; -unity-text-outline-width: 5px; text-shadow: 0 5px 1px rgb(58, 20, 64); white-space: nowrap; }
.ob-look-count { display: none; }
.ob-tag {
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 38px; color: rgb(58, 20, 64); margin: 0 0 0 22px;
    padding: 4px 16px 6px 16px; background-color: rgb(255, 212, 84); border-width: 4px; border-color: rgb(58, 20, 64); border-radius: 18px;
}

/* ------------------------------------------------------------------ creator: the question */

.ob-right { position: absolute; left: 560px; right: 0; top: 160px; bottom: 0; }
.ob-mode-look .ob-right { left: 950px; top: 140px; }
.ob-mode-custom .ob-right { left: 720px; }
.ob-mode-side .ob-right { left: 780px; }
.ob-mode-confirm .ob-right { left: 0; }

/* Character step: the base-model portrait grid (scrolls when there are many) */
/* Character step: a roster of portrait tiles, not cards (user review 2026-10-10): no white face, no lip, the portrait is
   the tile, its name sits under it on the painting. Two rows show; the scroll stops above the CTA hint. */
.ob-model-scroll { height: 518px; }
.ob-character-filters { flex-direction: row; margin-bottom: 18px; margin-top: 6px; }
.ob-character-filter {
    min-width: 145px; height: 68px; margin: 0 18px 0 0; padding: 0 24px; border-width: 0; border-bottom-width: 4px;
    border-color: rgba(0, 0, 0, 0); border-radius: 0; background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 38px; color: rgb(232, 220, 246);
    -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(58, 20, 64);
}
.ob-character-filter:hover, .ob-character-filter:focus { color: rgb(255, 255, 255); border-color: rgba(255, 255, 255, 0.4); }
.ob-character-filter.ob-character-filter--on { color: rgb(255, 255, 255); border-color: rgb(255, 212, 84); }
.ob-likeness-overlay {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(26, 8, 32, 0.85); align-items: center; justify-content: center;
}
.ob-likeness-sheet {
    width: 1600px; padding: 60px; background-color: rgb(58, 20, 64); border-radius: 30px;
    border-width: 5px; border-color: rgb(84, 38, 92);
}
.ob-likeness-selected { font-size: 38px; color: rgb(20, 241, 149); margin-bottom: 26px; }
.ob-likeness-description { font-size: 38px; color: rgb(255, 255, 255); white-space: normal; margin-bottom: 18px; }
.ob-likeness-status { font-size: 32px; color: rgb(255, 212, 84); white-space: normal; margin-top: 26px; margin-bottom: 38px; }
.ob-likeness-actions { flex-direction: row; justify-content: flex-end; }
.ob-likeness-actions .kit-btn { margin-left: 26px; }
.ob-model-card { padding-bottom: 0; }
.ob-model-card > .kit-card__lip { display: none; }
.ob-model-card > .kit-card__face, .ob-model-card.kit-card--selected > .kit-card__face {
    padding: 0; justify-content: flex-start; background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0;
}
.ob-model-card .kit-card__badge {
    width: 100%; height: 190px; -unity-background-scale-mode: scale-to-fit; background-color: rgb(232, 220, 246);
    border-width: 3px; border-color: rgba(255, 255, 255, 0.45); border-radius: 24px;
}
.ob-model-card.kit-card--selected .kit-card__badge { background-color: rgb(214, 252, 234); border-color: rgb(20, 241, 149); border-width: 5px; }
.ob-model-card .kit-card__disc { width: 150px; height: 150px; border-radius: 75px; margin-top: 12px; }
.ob-model-card .kit-card__copy { width: 100%; min-width: 0; }
.ob-model-card .kit-card__title {
    width: 100%; font-size: 28px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    -unity-text-align: upper-center; margin-top: 8px; color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(58, 20, 64); text-shadow: 0 3px 3px rgba(26, 8, 32, 0.85);
}
.ob-model-card > .kit-card__check { top: 8px; right: 8px; width: 58px; height: 58px; }

/* Customize step: the category rail and its options */
.ob-custom-body { flex-direction: column; height: 640px; padding: 28px 32px; background-color: rgb(255, 255, 255); border-radius: 24px; }
.ob-rail-scroll { height: 92px; flex-shrink: 0; }
.ob-rail { flex-direction: row; padding-bottom: 12px; }
.ob-rail-item, .ob-rail-item:hover, .ob-rail-item:focus, .ob-rail-item:active {
    flex-direction: row; align-items: center; margin: 0 14px 0 0; padding: 0 24px; height: 72px; flex-shrink: 0;
    background-color: rgb(255, 255, 255); border-width: 0; border-bottom-width: 4px; border-color: rgba(58, 20, 64, 0.12); border-radius: 0;
}
.ob-rail-item.ob-rail-item--on, .ob-rail-item.ob-rail-item--on:hover, .ob-rail-item.ob-rail-item--on:focus { border-color: rgb(8, 168, 104); }
.ob-rail-item .kit-badge { width: 92px; height: 92px; }
.ob-rail-label {
    -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); font-size: 30px; color: rgb(58, 20, 64); margin: 0; padding: 0;
    -unity-text-outline-width: 0; white-space: nowrap;
}
.ob-rail-item--on .ob-rail-label { color: rgb(58, 20, 64); -unity-text-outline-width: 0; }
.ob-custom-options { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.ob-option-scroll { height: 466px; }
.ob-option-selection { font-size: 32px; color: rgb(58, 20, 64); margin: 8px 0 20px 0; -unity-text-outline-width: 0; }
/* The selected badge extends 16px above / 14px right; the selection pop needs a little more room. */
.ob-options { padding: 4px; }
.ob-option-card > .kit-card__face { justify-content: center; padding: 12px; }
.ob-option-card .kit-card__badge { width: 100%; height: 120px; -unity-background-scale-mode: scale-to-fit; }

.ob-swatch { width: 96px; height: 96px; flex-shrink: 0; border-radius: 48px; border-width: 7px; border-color: rgb(58, 20, 64); margin-bottom: 6px; }
.ob-option-card .kit-card__copy { width: 100%; min-width: 0; }
.ob-option-card .kit-card__title { font-size: 28px; -unity-text-align: upper-center; }
.ob-option-card--swatch > .kit-card__face, .ob-option-card--swatch.kit-card--selected > .kit-card__face { border-width: 0; background-color: rgba(0, 0, 0, 0); }
.ob-option-card--swatch .ob-swatch { width: 88px; height: 88px; border-width: 2px; border-color: rgba(58, 20, 64, 0.18); margin: 0; }
.ob-option-card--swatch.kit-card--selected .ob-swatch { border-width: 7px; border-color: rgb(8, 168, 104); }
.ob-swatch-reset { width: 88px; height: 88px; align-items: center; justify-content: center; border-width: 2px; border-color: rgba(58, 20, 64, 0.18); border-radius: 44px; margin: 0; }
.ob-swatch-reset > .ct-icon { width: 48px; height: 48px; -unity-background-image-tint-color: rgb(58, 20, 64); }
.ob-option-card--swatch.kit-card--selected .ob-swatch-reset { border-width: 7px; border-color: rgb(8, 168, 104); }
.ob-option-card--swatch .kit-card__title { font-size: 24px; }
.ob-option-card--swatch > .kit-card__check { display: none; }
.ob-customize-tag, .ob-customize-tag:hover, .ob-customize-tag:focus {
    flex-direction: row; align-items: center; align-self: center; flex-shrink: 0; margin: 0 0 0 auto; padding: 0 24px;
    height: 80px; background-color: rgb(255, 212, 84); border-width: 0; border-radius: 18px;
}
.ob-customize-tag:active { background-color: rgb(255, 200, 60); }
.ob-customize-label, .ob-customize-arrow { color: rgb(58, 20, 64); -unity-text-outline-width: 0; margin: 0; padding: 0; }
.ob-customize-label { font-size: 32px; }
.ob-customize-arrow { font-size: 52px; margin-left: 24px; }
.ob-personal-note { padding: 40px; background-color: rgb(255, 255, 255); border-radius: 24px; }
.ob-personal-title { font-size: 48px; color: rgb(58, 20, 64); -unity-text-outline-width: 0; }
.ob-personal-body { font-size: 34px; color: rgb(58, 20, 64); -unity-text-outline-width: 0; white-space: normal; margin: 20px 0 32px 0; }
.ob-stock-return { height: 96px; padding: 0 28px; align-self: flex-start; font-size: 30px; background-color: rgb(255, 255, 255); color: rgb(58, 20, 64); border-width: 2px; border-color: rgb(58, 20, 64); border-radius: 18px; }
/* Keep scroll affordances visible without changing the native touch / wheel behaviour. */
.ob-custom-body .unity-scroller--vertical { width: 24px; margin-left: 10px; }
.ob-custom-body .unity-scroller__low-button, .ob-custom-body .unity-scroller__high-button { display: none; }
.ob-custom-body .unity-base-slider__tracker { background-color: rgba(58, 20, 64, 0.4); border-radius: 12px; }
.ob-custom-body .unity-base-slider__dragger { background-color: rgb(255, 255, 255); border-width: 4px; border-color: rgb(58, 20, 64); border-radius: 12px; }

/* Illustrated collectible surface: the artwork owns its rim, pattern and separators.
   Actual avatar and editable identity are composited over the same card. */
.ob-mode-confirm .ob-title-row { display: none; }
.ob-mode-confirm .ob-right { top: 130px; align-items: center; }
.ob-idcard {
    width: 1520px; height: 760px; margin-top: 0; overflow: hidden;
    background-color: rgb(255, 255, 255); border-width: 0; border-radius: 64px;
    -unity-background-scale-mode: stretch-to-fill;
}
.ob-card-body { position: absolute; left: 0; top: 0; right: 0; bottom: 0; flex-direction: row; }
.ob-card-hit, .ob-card-hit:hover, .ob-card-hit:focus, .ob-card-hit:active {
    margin: 0; padding: 0; border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0); align-items: stretch;
}
.ob-card-hit:active { opacity: 0.7; }
.ob-card-portrait-hit, .ob-card-portrait-hit:hover, .ob-card-portrait-hit:focus, .ob-card-portrait-hit:active {
    width: 590px; flex-shrink: 0; overflow: visible; background-color: rgba(0, 0, 0, 0);
}
.ob-card-portrait { position: absolute; left: -110px; top: 12px; width: 810px; height: 870px; -unity-background-scale-mode: scale-to-fit; }
.ob-card-edition {
    position: absolute; left: 44px; top: 40px; width: 300px; height: 62px; padding: 0; margin: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 32px; letter-spacing: 4px; color: rgb(58, 20, 64);
    -unity-text-align: middle-center;
}
.ob-card-info { flex-grow: 1; position: relative; padding: 0; }
.ob-card-header { position: absolute; left: 26px; right: 46px; top: 46px; flex-direction: column; align-items: flex-start; }
.ob-card-row--name { align-items: flex-start; justify-content: center; width: 100%; }
.ob-card-name {
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 104px; color: rgb(58, 20, 64); margin: 0; padding: 0; white-space: nowrap;
}
.ob-card-row--tribe { flex-direction: row; align-items: center; margin-bottom: 8px; }
.ob-card-tribe-badge { width: 70px; height: 70px; -unity-background-scale-mode: scale-to-fit; }
.ob-card-tribe {
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 30px; letter-spacing: 3px; color: rgb(58, 20, 64);
    margin: 0 0 0 14px; padding: 0; white-space: normal;
}
.ob-card-dream { position: absolute; left: 26px; right: 46px; top: 432px; height: 132px; flex-direction: row; align-items: center; }
.ob-card-dream-art { width: 94px; height: 94px; margin-right: 18px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.ob-card-dream-copy { flex-grow: 1; flex-shrink: 1; align-items: flex-start; }
.ob-card-caption {
    -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); font-size: 24px; letter-spacing: 3px; color: rgb(120, 86, 124);
    margin: 0 0 6px 0; padding: 0;
}
.ob-card-line { flex-direction: row; align-items: center; }
.ob-card-origin-art { width: 42px; height: 58px; -unity-background-scale-mode: scale-to-fit; }
.ob-card-value {
    -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); font-size: 38px; color: rgb(58, 20, 64); margin: 0; padding: 0; white-space: normal; -unity-text-align: middle-left;
}
.ob-card-row--static .ob-card-value { font-size: 28px; margin-left: 14px; }
.ob-card-traits-hit { position: absolute; left: 26px; right: 46px; bottom: 40px; height: 118px; border-width: 0; padding: 0; justify-content: center; }
.ob-card-traits { justify-content: flex-start; }
.ob-card-trait { flex-direction: row; align-items: center; margin-right: 20px; flex-shrink: 1; }
.ob-card-trait > .kit-badge { width: 80px; height: 80px; margin-right: 10px; flex-shrink: 0; }
.ob-card-value--trait { font-size: 28px; flex-shrink: 1; }
.ob-card-foot { width: 1210px; height: 82px; flex-direction: row; align-items: center; justify-content: space-between; margin-top: 8px; }
.ob-card-foot .ob-age-row { min-height: 82px; height: 82px; }
.ob-card-foot .kit-check__box { width: 62px; height: 62px; border-width: 5px; border-radius: 14px; }
.ob-card-foot .kit-check__label { font-size: 40px; }
.ob-card-edit-hint { font-size: 26px; }
.ob-note--card { font-size: 26px; margin-top: 4px; max-width: 1550px; }
.ob-screen.ob-typing .ob-right { left: 380px; top: 0; }
.ob-page { flex-direction: column; }
.ob-title-row { flex-direction: row; align-items: flex-end; margin-bottom: 12px; }
.ob-title-row > .ob-sub { margin-bottom: 10px; }
.ob-typing .ob-title-row { display: none; }


.ob-dots { flex-direction: row; margin: 0 0 18px 26px; }
.ob-dot { width: 44px; height: 44px; border-radius: 22px; margin-right: 12px; border-width: 5px; border-color: rgb(58, 20, 64); background-color: rgba(255, 255, 255, 0.55); }
.ob-dot--on { background-color: rgb(20, 241, 149); }

.ob-tribe-card .kit-card__badge { width: 108px; height: 108px; }
.ob-tribe-card > .kit-card__face { padding-top: 14px; padding-bottom: 8px; }
.ob-tribe-card .kit-card__title { font-size: 34px; margin-top: 4px; }
.ob-tribe-card .kit-card__sub { font-size: 25px; }
.ob-dream-card > .kit-card__face { padding-top: 10px; padding-bottom: 10px; }
.ob-dream-card .kit-card__title { font-size: 34px; white-space: normal; }
.ob-dream-card .kit-card__badge { width: 100px; height: 100px; flex-shrink: 0; }
/* Traits: 44px keeps the longest name ("Diamond Hands") on one line beside the icon (device 2026-10-10). */
.ob-trait-card .kit-card__title { font-size: 34px; }
.ob-trait-card .kit-card__sub, .ob-dream-card .kit-card__sub { font-size: 27px; }

/* Name: one big field. While typing, the field and the character's face move into the strip above the keyboard. */
.ob-field-row { flex-direction: row; align-items: center; margin-top: 20px; }
.ob-field { flex-grow: 1; max-width: 1180px; height: 150px; margin: 0; }
.ob-field > .unity-base-text-field__input {
    margin: 0; padding: 0 40px; border-width: 6px; border-bottom-width: 14px; border-color: rgb(58, 20, 64); border-radius: 34px;
    background-color: rgb(255, 255, 255); color: rgb(58, 20, 64);
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 72px; -unity-text-align: middle-left;
}
.ob-field--ok > .unity-base-text-field__input { border-color: rgb(8, 168, 104); }
.ob-field .unity-base-text-field__input--placeholder { color: rgba(58, 20, 64, 0.45); }
.ob-done { margin-left: 24px; display: none; }
.ob-typing .ob-done { display: flex; }
.ob-alias-status { font-size: 46px; -unity-text-outline-width: 3px; text-shadow: 0 3px 4px rgba(26, 8, 32, 0.85); margin-top: 22px; }
.ob-alias-status--ok { color: rgb(124, 255, 196); }
.ob-alias-status--warn { color: rgb(255, 214, 140); }
.ob-typing .ob-topbar, .ob-typing .ob-cta-zone, .ob-typing .ob-creator-error { display: none; }
.ob-typing .ob-field-row { margin-top: 0; }
.ob-typing .ob-alias-status { margin-top: 14px; }

/* Confirm: the summary chips (tap to change), the 18+ toggle card with its label, the money line. */
.ob-creator-error { position: absolute; left: 560px; right: 520px; bottom: 6px; }

/* Celebration. */
.ob-celebrate { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; }
.ob-celebrate-title { margin-top: 186px; font-size: 104px; -unity-text-outline-width: 6px; text-shadow: 0 7px 1px rgb(58, 20, 64); -unity-text-align: upper-center; }
.ob-celebrate-sub { margin-top: 6px; font-size: 50px; -unity-text-outline-width: 4px; text-shadow: 0 4px 3px rgba(26, 8, 32, 0.85); }
.ob-enter-city { position: absolute; right: 72px; bottom: 30px; }
.ob-mode-celebrate .ob-look-controls, .ob-mode-celebrate .ob-right, .ob-mode-celebrate .ob-creator-error { display: none; }
.ob-cta-blocker { position: absolute; left: 0; right: 0; bottom: 0; height: 150px; }

/* One compact, flat surface vocabulary throughout the first-time choices. */
.ob-screen .kit-card { padding-bottom: 0; }
.ob-screen .kit-card > .kit-card__lip { display: none; }
.ob-screen .kit-card > .kit-card__face { background-color: rgb(255, 255, 255); border-width: 2px; border-color: rgba(58, 20, 64, 0.16); border-radius: 24px; }
.ob-screen .kit-card.kit-card--selected > .kit-card__face { background-color: rgb(255, 255, 255); border-width: 5px; border-color: rgb(8, 168, 104); }
.ob-screen .kit-card:active > .kit-card__face, .ob-screen .kit-card--pressed > .kit-card__face { translate: 0 0; }
.ob-screen .kit-card > .kit-card__check { width: 44px; height: 44px; top: 10px; right: 10px; border-width: 2px; }
.ob-screen .ob-model-card > .kit-card__face, .ob-screen .ob-model-card.kit-card--selected > .kit-card__face { background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; }
.ob-screen .ob-option-card--swatch > .kit-card__face, .ob-screen .ob-option-card--swatch.kit-card--selected > .kit-card__face { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.ob-screen .ob-option-card--swatch > .kit-card__check { display: none; }
.ob-screen .ob-flat-button { padding-bottom: 0; height: 116px; min-height: 116px; }
.ob-screen .ob-flat-button > .kit-btn__lip, .ob-screen .ob-flat-button .kit-btn__shine-clip, .ob-screen .ob-flat-button .kit-btn__icon--drop { display: none; }
.ob-screen .ob-flat-button > .kit-btn__face {
    background-image: none; background-color: rgb(20, 241, 149); border-width: 0; border-radius: 24px;
    padding: 0 56px; translate: 0 0; scale: 1 1;
}
.ob-screen .ob-flat-button:active > .kit-btn__face, .ob-screen .ob-flat-button.kit-btn--pressed > .kit-btn__face { translate: 0 0; scale: 0.98 0.98; }
.ob-screen .ob-flat-button .kit-btn__label { color: rgb(58, 20, 64); font-size: 44px; -unity-text-outline-width: 0; text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
.ob-screen .ob-flat-button.kit-btn--white > .kit-btn__face { background-color: rgb(255, 255, 255); padding: 0; }
.ob-screen .ob-flat-button:disabled > .kit-btn__face { background-color: rgb(232, 220, 246); translate: 0 0; }
.ob-screen .ob-flat-button:disabled .kit-btn__label { color: rgb(120, 86, 124); }
.ob-screen .ob-flat-button .kit-btn__icon { -unity-background-image-tint-color: rgb(58, 20, 64); }
