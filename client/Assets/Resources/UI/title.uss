/* Title screen (SignInScreen), approved 2026-10-16: mock ct-life-evidence/title-keyart-20261016/blender/title-final-B-v3.png
   (source compose.html, layout v3; 1 CSS px there = 2 device px on the 2670x1200 Seeker = 1.80 panel units, since the panel
   is 2400 units wide). Values below are the mock's device px divided by 1.1125. */

.ct-title { background-color: rgba(0, 0, 0, 0); overflow: visible; } /* visible: SafeAreaBleed extends the art under the cutout, outside the screen root */

.ct-title-bg {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("Title/title-keyart-b.png");
    /* Cover, centred. The two characters sit at ~22% and ~80% of the 2.22:1 art, so a 16:9 screen (crop 10% a side)
       still frames both; a wider screen crops top and bottom only. */
    -unity-background-scale-mode: scale-and-crop;
    transition-property: scale; transition-duration: 20s; transition-timing-function: ease-in-out;
}
.ct-title-bg.ct-title-zoom { scale: 1.015 1.015; } /* Ken Burns: 1.5% */

/* Mock .shade-b: the bottom 50%, rgba(10,6,24,.55) at the edge fading to clear (texture built in code). */
.ct-title-shade { position: absolute; left: 0; right: 0; bottom: 0; top: 50%; -unity-background-scale-mode: stretch-to-fill; }

/* Lockup (baked once from the mock HTML: CT mark + LIFE in Lilita One, plum outline, -4 deg, soft shadow), 900x360 device px,
   centred at 47% height (mock: top 50%, translate -62% of its 150 css px height). */
.ct-title-logo {
    position: absolute; left: 50%; top: 47%; width: 809px; height: 324px; translate: -50% -50%;
    background-image: url("Title/title-logo.png"); -unity-background-scale-mode: scale-to-fit;
}

.ct-title-bottom { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }

/* Mock .tap (v3): Inter 700 13 css px = 26 device px, letter-spacing 3 css, bottom 76 css. Also the status line. */
.ct-title-status {
    position: absolute; left: 0; right: 0; bottom: 137px; margin: 0; padding: 0;
    font-size: 23px; letter-spacing: 2px; color: rgb(255, 255, 255); -unity-text-align: lower-center; white-space: nowrap;
    -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); text-shadow: 0 3px 16px rgba(0, 0, 0, 0.55);
}
.ct-title-status.ct-title-tap { -unity-font-definition: url("Fonts/Phone/Inter-Bold.ttf"); letter-spacing: 10.5px; }

/* Mock .bar: 360x8 css = 720x16 device px, radius 5 css, white on 28% white, bottom 58 css. */
.ct-title-bar {
    position: absolute; left: 50%; bottom: 104px; width: 647px; height: 14px; translate: -50% 0;
    border-radius: 9px; background-color: rgba(255, 255, 255, 0.28); overflow: hidden;
}
.ct-title-bar-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; border-radius: 9px; background-color: rgb(255, 255, 255); }
.ct-title-bar-failed { background-color: rgba(255, 255, 255, 0.18); }
.ct-title-bar-failed .ct-title-bar-fill { background-color: rgba(255, 255, 255, 0.55); }

/* The real boot error above the bar, with a retry capsule where "Tap to play" goes. */
.ct-title-error {
    position: absolute; left: 22%; right: 22%; bottom: 196px; margin: 0; padding: 0;
    font-size: 22px; color: rgb(255, 255, 255); -unity-text-align: lower-center; white-space: normal;
    -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
}
.ct-title-retry {
    position: absolute; left: 50%; bottom: 126px; translate: -50% 0; height: 56px; min-width: 200px; margin: 0; padding: 0 36px;
    border-width: 0; border-radius: 28px; background-color: rgb(255, 255, 255);
    font-size: 22px; letter-spacing: 1px; color: rgb(42, 11, 74); -unity-font-definition: url("Fonts/Phone/Inter-Bold.ttf");
}
.ct-title-retry:hover { background-color: rgb(255, 255, 255); }
.ct-title-retry:active { opacity: 0.8; }

/* Mock .legal: Inter 500 10.5 css = 21 device px, 78% white, bottom 12 css. */
.ct-title-legal {
    position: absolute; left: 0; right: 0; bottom: 22px; margin: 0; padding: 0;
    font-size: 19px; color: rgba(255, 255, 255, 0.78); -unity-text-align: lower-center; white-space: nowrap;
    -unity-font-definition: url("Fonts/Phone/Inter-Medium.ttf"); text-shadow: 0 2px 7px rgba(0, 0, 0, 0.6);
}

/* ---------- sign-in sheet (no session): white, iOS-like, the Duo kit language ---------- */
.ct-title-sheet-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; justify-content: flex-end; align-items: center; }
.ct-title-sheet-scrim {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0; margin: 0; padding: 0; border-width: 0; border-radius: 0;
    background-color: rgba(0, 0, 0, 0.32);
}
.ct-title-sheet-scrim:hover, .ct-title-sheet-scrim:active { background-color: rgba(0, 0, 0, 0.32); }
.ct-title-sheet {
    width: 860px; padding: 16px 56px 34px; background-color: rgb(255, 255, 255);
    border-top-left-radius: 40px; border-top-right-radius: 40px; align-items: stretch;
}
.ct-title-sheet Label { margin: 0; padding: 0; -unity-text-outline-width: 0; }
.ct-title-sheet-grabber { width: 72px; height: 8px; border-radius: 4px; background-color: rgba(60, 60, 67, 0.3); align-self: center; margin-bottom: 26px; }
.ct-title-sheet .ct-title-sheet-title { font-size: 34px; color: rgb(0, 0, 0); -unity-text-align: middle-center; -unity-font-definition: url("Fonts/Phone/Inter-Bold.ttf"); letter-spacing: -0.5px; }
.ct-title-sheet .ct-title-sheet-body {
    font-size: 23px; color: rgba(60, 60, 67, 0.62); -unity-text-align: middle-center; white-space: normal; margin: 10px 40px 30px;
    -unity-font-definition: url("Fonts/Phone/Inter-Regular.ttf");
}
/* Primary squircle (corner radius ~28% of the height). */
.ct-title-sheet-primary {
    height: 104px; margin: 0; padding: 0 40px; border-width: 0; border-radius: 30px; background-color: rgb(17, 12, 26);
    flex-direction: row; justify-content: center; align-items: center;
    font-size: 29px; color: rgb(255, 255, 255); -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); -unity-text-align: middle-center;
    transition-property: scale; transition-duration: 0.08s;
}
.ct-title-sheet-primary:hover, .ct-title-sheet-primary:focus { background-color: rgb(17, 12, 26); }
.ct-title-sheet-primary:active { scale: 0.98 0.98; opacity: 0.85; }
.ct-title-sheet-primary:disabled { opacity: 0.5; }
.ct-title-sheet .ct-title-sheet-primary-label { font-size: 29px; color: rgb(255, 255, 255); -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); }
.ct-title-sheet-primary-icon { width: 38px; height: 34px; margin-right: 18px; -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.ct-title-sheet .ct-title-sheet-error {
    font-size: 22px; color: rgb(196, 39, 29); -unity-text-align: middle-center; white-space: normal; margin-top: 18px;
    -unity-font-definition: url("Fonts/Phone/Inter-Medium.ttf");
}
.ct-title-sheet .ct-title-sheet-legal {
    font-size: 18px; color: rgba(60, 60, 67, 0.55); -unity-text-align: middle-center; white-space: normal; margin-top: 24px;
    -unity-font-definition: url("Fonts/Phone/Inter-Regular.ttf");
}
