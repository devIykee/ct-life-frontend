/* CT Life UI kit (Scripts/UI/Kit): LippedButton, ChoiceCard, ProgressBar, SpeechBubble, CelebrationBurst.
   Identity (approved title screen, 2026-10-08): painted squircle bodies, Lilita One, cream text rgb(255, 246, 228) with a
   thick plum outline rgb(58, 20, 64), no translucent plates behind text.
   Units: the landscape panel is 2400 x 1080 units; on the Seeker (2670 x 1200, 480 dpi) 1 unit = 1.112 px and
   1 dp = 2.7 units, so 48 dp = 130 units (minimum tap target) and 14 dp = 38 units (minimum text). Timings: spec B7. */

/* ------------------------------------------------------------------ LippedButton */

.kit-btn, .kit-btn:hover, .kit-btn:focus, .kit-btn:active, .kit-btn:disabled {
    margin: 0; padding: 0 0 12px 0; border-width: 0; border-radius: 0;
    background-color: rgba(0, 0, 0, 0); opacity: 1; overflow: visible;
}
.kit-btn { min-width: 130px; min-height: 130px; flex-direction: column; flex-shrink: 0; }

.kit-btn__lip {
    position: absolute; left: 3px; right: 3px; top: 16px; bottom: 0;
    border-radius: 34px; background-color: rgb(58, 20, 64);
}
.kit-btn__face {
    flex-grow: 1; flex-direction: row; justify-content: center; align-items: center;
    padding: 0 56px 8px 56px; overflow: hidden;
    transition-property: translate; transition-duration: 0.14s; transition-timing-function: ease-out-back;
}
/* Press: the face travels the lip's depth in 60 ms and the lip disappears under it. */
.kit-btn:active > .kit-btn__face, .kit-btn--pressed > .kit-btn__face {
    translate: 0 12px; transition-duration: 0.06s; transition-timing-function: ease-out;
}

.kit-btn__label {
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 58px; white-space: nowrap;
    -unity-text-align: middle-center; letter-spacing: 1px; margin: 0; padding: 0;
    color: rgb(255, 246, 228); -unity-text-outline-width: 4px; -unity-text-outline-color: rgb(58, 20, 64);
    text-shadow: 0 4px 1px rgb(58, 20, 64);
}

/* Painted bodies: the approved squircle art, 9-sliced in code (slices + scale) so the corners keep their shape. */
.kit-btn--green > .kit-btn__face { background-image: url("Title/btn-green-blank-sq.png"); }
.kit-btn--purple > .kit-btn__face { background-image: url("Title/btn-purple-blank-sq.png"); }
.kit-btn--green > .kit-btn__lip { background-color: rgb(30, 70, 34); border-width: 4px; border-color: rgb(58, 20, 64); }
.kit-btn--purple > .kit-btn__lip { background-color: rgb(52, 22, 84); border-width: 4px; border-color: rgb(58, 20, 64); }

/* Cream: the secondary/neutral body drawn in USS (cream fill, plum outline), plum label without an outline. */
.kit-btn--cream > .kit-btn__face {
    background-color: rgb(255, 246, 228); border-width: 6px; border-color: rgb(58, 20, 64); border-radius: 34px;
}
.kit-btn--cream .kit-btn__label { color: rgb(58, 20, 64); -unity-text-outline-width: 0; text-shadow: 0 0 0 rgba(0, 0, 0, 0); }

/* Disabled: a flat pale face, pressed in, no lip, no shine, muted label (spec B1). */
.kit-btn:disabled > .kit-btn__face {
    background-image: none; background-color: rgb(232, 222, 210); border-width: 6px; border-color: rgb(120, 92, 124);
    border-radius: 34px; translate: 0 12px;
}
.kit-btn:disabled > .kit-btn__lip { display: none; }
.kit-btn:disabled .kit-btn__label {
    color: rgb(120, 92, 124); -unity-text-outline-width: 0; text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}
.kit-btn:disabled .kit-btn__shine-clip { display: none; }

/* Sizes. Large is the CTA (150 units = 56 dp), Medium the secondary (130 units = 48 dp). */
.kit-btn--large { height: 150px; min-width: 400px; }
.kit-btn--medium { height: 130px; padding-bottom: 10px; }
.kit-btn--medium > .kit-btn__face { padding: 0 40px 6px 40px; }
.kit-btn--medium .kit-btn__label { font-size: 44px; -unity-text-outline-width: 3px; text-shadow: 0 3px 1px rgb(58, 20, 64); }
.kit-btn--medium:active > .kit-btn__face, .kit-btn--medium.kit-btn--pressed > .kit-btn__face, .kit-btn--medium:disabled > .kit-btn__face { translate: 0 10px; }
.kit-btn--square { width: 150px; height: 150px; }
.kit-btn--square > .kit-btn__face { padding: 0 0 8px 0; }
.kit-btn--round { width: 130px; height: 130px; padding-bottom: 10px; }
.kit-btn--round > .kit-btn__face, .kit-btn--round:disabled > .kit-btn__face { padding: 0; border-radius: 60px; }
.kit-btn--round > .kit-btn__lip { border-radius: 60px; }
.kit-btn--round:active > .kit-btn__face, .kit-btn--round.kit-btn--pressed > .kit-btn__face, .kit-btn--round:disabled > .kit-btn__face { translate: 0 10px; }

.kit-btn__icon-holder { width: 72px; height: 72px; }
.kit-btn__icon { position: absolute; left: 0; top: 0; width: 72px; height: 72px; -unity-background-image-tint-color: rgb(255, 246, 228); }
.kit-btn__icon--drop { top: 5px; -unity-background-image-tint-color: rgb(58, 20, 64); }
.kit-btn--square .kit-btn__icon-holder, .kit-btn--square .kit-btn__icon { width: 84px; height: 84px; }
.kit-btn--cream .kit-btn__icon { -unity-background-image-tint-color: rgb(58, 20, 64); }
.kit-btn--cream .kit-btn__icon--drop { display: none; }

/* The light sweep (as on the title button), clipped to the painted rounded shape. */
.kit-btn__shine-clip { position: absolute; left: 6px; right: 6px; top: 6px; bottom: 10px; border-radius: 28px; overflow: hidden; }
.kit-btn__shine { position: absolute; top: -30%; bottom: -30%; left: -35%; width: 14%; background-color: rgba(255, 255, 255, 0.24); rotate: 18deg; }

/* ------------------------------------------------------------------ ChoiceCard */

.kit-card, .kit-card:hover, .kit-card:focus, .kit-card:active, .kit-card:disabled {
    margin: 0; padding: 0 0 12px 0; border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0); overflow: visible;
}
.kit-card { flex-direction: column; min-height: 130px; opacity: 1; }
.kit-card:disabled { opacity: 0.45; }
.kit-card__lip {
    position: absolute; left: 0; right: 0; top: 18px; bottom: 0; border-radius: 36px;
    background-color: rgb(120, 86, 124); border-width: 5px; border-color: rgb(58, 20, 64);
}
.kit-card__face {
    flex-grow: 1; align-items: center; justify-content: center; padding: 18px 22px;
    background-color: rgb(255, 246, 228); border-width: 6px; border-color: rgb(58, 20, 64); border-radius: 36px;
    transition-property: translate, background-color; transition-duration: 0.14s, 0.12s;
    transition-timing-function: ease-out-back, ease-out;
}
.kit-card:active > .kit-card__face, .kit-card--pressed > .kit-card__face {
    translate: 0 12px; transition-duration: 0.06s, 0.12s; transition-timing-function: ease-out, ease-out;
}
.kit-card--v > .kit-card__face { flex-direction: column; justify-content: flex-start; padding-top: 22px; }
.kit-card--h > .kit-card__face { flex-direction: row; justify-content: flex-start; padding-left: 22px; }

.kit-card__copy { flex-shrink: 1; flex-grow: 1; justify-content: center; }
.kit-card--v .kit-card__copy { align-items: center; flex-grow: 0; }
.kit-card--h .kit-card__copy { margin-left: 22px; }
.kit-card__caption {
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 38px; letter-spacing: 2px;
    color: rgb(120, 86, 124); margin: 0; padding: 0;
}
.kit-card__title {
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 50px; color: rgb(58, 20, 64);
    white-space: normal; margin: 0; padding: 0;
}
.kit-card--v .kit-card__title { -unity-text-align: upper-center; margin-top: 8px; }
.kit-card__sub {
    -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); font-size: 38px; color: rgb(96, 52, 104);
    white-space: normal; margin: 4px 0 0 0; padding: 0;
}
.kit-card--v .kit-card__sub { -unity-text-align: upper-center; }

.kit-card__badge { width: 120px; height: 120px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.kit-card__disc {
    width: 104px; height: 104px; flex-shrink: 0; border-radius: 52px; border-width: 5px; border-color: rgb(58, 20, 64);
    align-items: center; justify-content: center;
}
.kit-card__disc--purple { background-color: rgb(146, 88, 220); }
.kit-card__disc--green { background-color: rgb(92, 196, 74); }
.kit-card__disc--gold { background-color: rgb(255, 196, 64); }
.kit-card__icon { width: 58px; height: 58px; -unity-background-image-tint-color: rgb(255, 246, 228); }
.kit-card__disc--gold .kit-card__icon { -unity-background-image-tint-color: rgb(58, 20, 64); }

/* Selected: the green-tinted face, the green lip, the check badge and a 1.04 pop (code). Never colour alone. */
.kit-card--selected > .kit-card__face { background-color: rgb(218, 246, 190); }
.kit-card--selected > .kit-card__lip { background-color: rgb(46, 128, 44); }
.kit-card__check {
    position: absolute; top: -16px; right: -14px; width: 68px; height: 68px; border-radius: 34px;
    background-color: rgb(92, 196, 74); border-width: 5px; border-color: rgb(58, 20, 64);
    align-items: center; justify-content: center; display: none;
}
.kit-card--selected > .kit-card__check { display: flex; }
.kit-card__tick {
    width: 18px; height: 34px; border-right-width: 8px; border-bottom-width: 8px; border-color: rgb(255, 246, 228);
    rotate: 45deg; translate: 0 -4px;
}

/* Error: red outline and a pink face (code adds a shake). */
.kit-card--error > .kit-card__face { border-color: rgb(196, 36, 64); background-color: rgb(255, 230, 230); }
.kit-card--error > .kit-card__lip { background-color: rgb(196, 36, 64); }

/* Checkbox toggle card (the 18+ confirmation): the square sits with its label. */
.kit-card__box {
    width: 84px; height: 84px; flex-shrink: 0; border-radius: 20px; border-width: 6px; border-color: rgb(58, 20, 64);
    background-color: rgb(255, 255, 255); align-items: center; justify-content: center;
}
.kit-card__box-tick {
    width: 22px; height: 42px; border-right-width: 9px; border-bottom-width: 9px; border-color: rgb(58, 20, 64);
    rotate: 45deg; translate: 0 -5px; display: none;
}
.kit-card--selected .kit-card__box { background-color: rgb(92, 196, 74); }
.kit-card--selected .kit-card__box-tick { display: flex; border-color: rgb(255, 246, 228); }
.kit-card--checkbox > .kit-card__check { display: none; }

.kit-grid { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }

/* ------------------------------------------------------------------ ProgressBar */

.kit-progress {
    height: 44px; flex-grow: 1; border-radius: 22px; overflow: hidden;
    background-color: rgba(58, 20, 64, 0.62); border-width: 5px; border-color: rgb(58, 20, 64);
}
.kit-progress__fill {
    position: absolute; left: 0; top: 0; bottom: 0; width: 0; border-radius: 17px;
    background-color: rgb(92, 196, 74);
    transition-property: width, background-color; transition-duration: 0.4s, 0.2s; transition-timing-function: ease-out-cubic, ease-out;
}
.kit-progress--instant .kit-progress__fill { transition-duration: 0s, 0s; }
.kit-progress__shine { position: absolute; left: 12px; right: 12px; top: 5px; height: 8px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.38); }
.kit-progress__notch { position: absolute; top: 0; bottom: 0; width: 5px; margin-left: -2px; background-color: rgb(58, 20, 64); }
.kit-progress--flash .kit-progress__fill { background-color: rgb(255, 226, 110); }

/* ------------------------------------------------------------------ SpeechBubble */

.kit-bubble {
    position: absolute; max-width: 580px; padding: 22px 32px 24px 32px;
    background-color: rgb(255, 246, 228); border-width: 6px; border-color: rgb(58, 20, 64); border-radius: 40px;
    display: none; opacity: 0; scale: 0.8 0.8;
    transition-property: scale, opacity; transition-duration: 0.22s, 0.16s; transition-timing-function: ease-out-back, ease-out;
}
.kit-bubble--shown { display: flex; }
.kit-bubble--in { opacity: 1; scale: 1 1; }
.kit-bubble__text {
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 46px; color: rgb(58, 20, 64);
    white-space: normal; margin: 0; padding: 0;
}
.kit-bubble__tail {
    position: absolute; width: 44px; height: 44px; background-color: rgb(255, 246, 228);
    border-color: rgb(58, 20, 64); rotate: 45deg;
}
.kit-bubble__tail--bottom-left { left: 64px; bottom: -26px; border-right-width: 6px; border-bottom-width: 6px; }
.kit-bubble__tail--bottom-right { right: 64px; bottom: -26px; border-right-width: 6px; border-bottom-width: 6px; }
.kit-bubble__tail--left { left: -26px; top: 36px; border-left-width: 6px; border-bottom-width: 6px; }

/* ------------------------------------------------------------------ CelebrationBurst */

.kit-burst { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; }
.kit-burst__p { position: absolute; left: 0; top: 0; }
.kit-burst__coin {
    width: 56px; height: 56px; margin-left: -28px; margin-top: -28px; border-radius: 28px;
    background-color: rgb(255, 200, 60); border-width: 5px; border-color: rgb(58, 20, 64);
}
.kit-burst__coin-hi { position: absolute; left: 9px; top: 7px; width: 16px; height: 12px; border-radius: 6px; background-color: rgba(255, 252, 226, 0.95); }
.kit-burst__confetti { width: 20px; height: 34px; margin-left: -10px; margin-top: -17px; border-radius: 4px; }
.kit-burst__puff {
    width: 230px; height: 230px; margin-left: -115px; margin-top: -115px;
    background-image: url("Kit/soft-glow.png"); -unity-background-image-tint-color: rgb(244, 238, 250);
}

/* ------------------------------------------------------------------ IconBadge (drawn medallion, like the tribe art) */

.kit-badge {
    width: 112px; height: 112px; flex-shrink: 0; border-radius: 56px; border-width: 7px; border-color: rgb(58, 20, 64);
    align-items: center; justify-content: center; overflow: hidden;
}
.kit-badge--painted { border-width: 0; border-radius: 0; -unity-background-scale-mode: scale-to-fit; background-color: rgba(0, 0, 0, 0); }
.kit-badge__inset { position: absolute; left: 0; right: 0; bottom: 0; height: 26%; background-color: rgba(30, 6, 40, 0.28); }
.kit-badge__bevel {
    position: absolute; left: 12%; top: 7%; width: 52%; height: 26%; border-radius: 40px; background-color: rgba(255, 255, 255, 0.28);
    rotate: -18deg;
}
.kit-badge__glyph { position: absolute; width: 56%; height: 56%; left: 22%; top: 20%; -unity-background-image-tint-color: rgb(255, 246, 228); }
.kit-badge__glyph--drop { top: 24%; -unity-background-image-tint-color: rgb(58, 20, 64); }
.kit-badge--green { background-color: rgb(92, 196, 74); }
.kit-badge--purple { background-color: rgb(146, 88, 220); }
.kit-badge--gold { background-color: rgb(244, 186, 52); }
.kit-badge--coral { background-color: rgb(240, 110, 90); }
.kit-badge--cyan { background-color: rgb(52, 178, 214); }
.kit-badge--orange { background-color: rgb(255, 146, 60); }
.kit-badge--plum { background-color: rgb(120, 60, 132); }

/* ------------------------------------------------------------------ IconTile */

.kit-tile, .kit-tile:hover, .kit-tile:focus, .kit-tile:active, .kit-tile:disabled {
    margin: 0; padding: 0; border-width: 0; background-color: rgba(0, 0, 0, 0); overflow: visible;
}
.kit-tile { width: 176px; height: 160px; }
.kit-tile:disabled { opacity: 0.5; }
.kit-tile__face {
    flex-grow: 1; align-items: center; justify-content: flex-start;
    transition-property: translate, scale; transition-duration: 0.14s, 0.14s; transition-timing-function: ease-out-back, ease-out-back;
}
.kit-tile:active > .kit-tile__face { translate: 0 6px; scale: 0.95 0.95; transition-duration: 0.06s, 0.06s; }
.kit-tile .kit-badge { width: 108px; height: 108px; }
.kit-tile__label {
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 40px; color: rgb(255, 246, 228); margin: 2px 0 0 0; padding: 0;
    -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(58, 20, 64); text-shadow: 0 3px 3px rgba(26, 8, 32, 0.85);
    white-space: nowrap; -unity-text-align: upper-center;
}

/* ------------------------------------------------------------------ StatChip */

.kit-chip, .kit-chip:hover, .kit-chip:focus, .kit-chip:active, .kit-chip:disabled {
    margin: 0; padding: 0 0 10px 0; border-width: 0; background-color: rgba(0, 0, 0, 0); overflow: visible;
}
.kit-chip { height: 140px; min-width: 300px; }
.kit-chip:disabled { opacity: 0.6; }
.kit-chip__lip {
    position: absolute; left: 0; right: 0; top: 16px; bottom: 0; border-radius: 34px;
    background-color: rgb(120, 86, 124); border-width: 5px; border-color: rgb(58, 20, 64);
}
.kit-chip__face {
    flex-grow: 1; flex-direction: row; align-items: center; padding: 0 30px 0 12px;
    background-color: rgb(255, 246, 228); border-width: 6px; border-color: rgb(58, 20, 64); border-radius: 34px;
    transition-property: translate; transition-duration: 0.14s; transition-timing-function: ease-out-back;
}
.kit-chip:active > .kit-chip__face { translate: 0 10px; transition-duration: 0.06s; }
.kit-chip .kit-badge { width: 96px; height: 96px; border-width: 6px; }
.kit-chip__copy { margin-left: 16px; justify-content: center; }
.kit-chip__caption {
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 38px; letter-spacing: 2px; color: rgb(120, 86, 124);
    margin: 0; padding: 0; white-space: nowrap;
}
.kit-chip__value {
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 54px; color: rgb(58, 20, 64); margin: -4px 0 0 0; padding: 0;
    white-space: nowrap;
}
.kit-chip__bar {
    height: 18px; width: 150px; margin-top: 2px; border-radius: 9px; overflow: hidden;
    background-color: rgba(58, 20, 64, 0.2); border-width: 3px; border-color: rgb(58, 20, 64);
}
.kit-chip__fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 6px; background-color: rgb(92, 196, 74); }
.kit-chip--warn > .kit-chip__face { background-color: rgb(255, 232, 178); }
.kit-chip--warn .kit-chip__fill { background-color: rgb(244, 160, 40); }
.kit-chip--bad > .kit-chip__face { background-color: rgb(255, 214, 204); }
.kit-chip--bad .kit-chip__fill { background-color: rgb(222, 64, 64); }
.kit-chip--bad .kit-chip__value { color: rgb(160, 24, 40); }
.kit-chip--debt > .kit-chip__face { background-color: rgb(255, 214, 164); }
.kit-chip--debt > .kit-chip__lip { background-color: rgb(196, 98, 30); }
.kit-chip__pip {
    position: absolute; top: -12px; right: -10px; width: 56px; height: 56px; border-radius: 28px; display: none;
    background-color: rgb(244, 160, 40); border-width: 5px; border-color: rgb(58, 20, 64); align-items: center; justify-content: center;
}
.kit-chip--bad > .kit-chip__pip { background-color: rgb(222, 64, 64); }
.kit-chip__pip-text {
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 38px; color: rgb(255, 246, 228); margin: 0; padding: 0;
    -unity-text-align: middle-center; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(58, 20, 64);
}

/* ------------------------------------------------------------------ Popover */

.kit-pop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.kit-pop__scrim { position: absolute; left: -400px; top: -400px; right: -400px; bottom: -400px; background-color: rgba(20, 6, 26, 0.18); }
.kit-pop__card {
    position: absolute; padding: 26px 34px 30px 34px;
    background-color: rgb(255, 246, 228); border-width: 6px; border-bottom-width: 14px; border-color: rgb(58, 20, 64); border-radius: 36px;
}
.kit-pop__tail {
    position: absolute; top: -28px; width: 44px; height: 44px; background-color: rgb(255, 246, 228);
    border-color: rgb(58, 20, 64); border-left-width: 6px; border-top-width: 6px; rotate: 45deg;
}
.kit-pop__title { -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 52px; color: rgb(58, 20, 64); margin: 0; padding: 0; }
.kit-pop__body {
    -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); font-size: 40px; color: rgb(80, 40, 88); white-space: normal;
    margin: 8px 0 0 0; padding: 0;
}
.kit-pop__action { margin-top: 22px; align-self: flex-start; }
