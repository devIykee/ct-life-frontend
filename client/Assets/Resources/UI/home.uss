/* Lobby "Arena" 2026-10-16 (approved mock lobby-v1, one Invite fren slot). Landscape 2400 x 1080 reference;
   mock CSS px x 1.8 = panel units. Plum #2a0b4a outlines, dark plum glass, mint CTA. Skewed shapes are SkewBox
   (Painter2D) because USS has no clip-path; gradients and the podium are textures built in LobbyArt. */
.home-screen { background-color: rgba(0,0,0,0); overflow: visible; }
.home-bg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }
.home-tint { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; }
.home-content { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* Quiet, art-led buttons: no default button chrome or kit depth bars anywhere in the lobby. */
.home-screen .unity-button, .home-screen .unity-button:hover, .home-screen .unity-button:active,
.home-screen .unity-button:focus, .home-screen .unity-button:hover:active {
    background-color: rgba(0,0,0,0); border-width: 0; border-radius: 0; margin: 0; padding: 0; min-width: 0; min-height: 0;
}
.home-screen .ct-button-depth, .home-screen .ct-button-glint { display: none; }
.home-screen .unity-button:active { scale: 0.97 0.97; }
.home-screen Label { color: rgb(255,255,255); }

.home-screen .lobby-outlined {
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); color: rgb(255,255,255); letter-spacing: 1px;
    -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(42,11,74);
}
.home-screen .lobby-outline-copy { -unity-text-outline-width: 2px; }
.lobby-outline-wrap { align-self: center; }
.lobby-icon, .home-pill-icon, .home-meter-icon, .home-corner-icon, .home-today-icon, .lobby-sticker-icon, .home-dream-crown {
    -unity-background-scale-mode: scale-to-fit; flex-shrink: 0;
}
.home-screen .lobby-badge {
    position: absolute; top: -11px; right: -11px; min-width: 43px; height: 43px; padding: 0 9px; border-radius: 22px;
    background-color: rgb(255,59,92); border-width: 5px; border-color: rgb(42,11,74);
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 23px; color: rgb(255,255,255);
    -unity-text-align: middle-center; white-space: nowrap;
}

/* ---------------------------------------------------------------- top-left player plate */
.home-plate { position: absolute; left: 29px; top: 25px; }
.home-screen .home-identity { flex-direction: row; align-items: flex-start; height: 92px; padding-left: 94px; overflow: visible; }
.home-avatar {
    position: absolute; left: 0; top: -6px; width: 119px; height: 119px; border-radius: 60px; border-width: 7px;
    border-color: rgb(255,255,255); background-color: rgb(93,52,200); -unity-background-scale-mode: scale-and-crop;
    align-items: center; justify-content: center; overflow: hidden;
}
.home-avatar-letter { -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 58px; -unity-text-align: middle-center; }
.home-namebar { height: 92px; padding: 11px 70px 0 47px; justify-content: flex-start; }
.home-greeting { -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 38px; max-width: 470px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; }
.home-eyebrow { -unity-font-definition: url("Fonts/Phone/Inter-Bold.ttf"); font-size: 19px; letter-spacing: 2px; color: rgb(185,245,216); white-space: nowrap; margin-top: 2px; -unity-text-align: middle-left; }
.home-meters { position: absolute; left: 105px; top: 96px; flex-direction: row; }
.home-screen .home-meter { flex-direction: row; align-items: center; height: 62px; padding: 0 6px; margin-right: 6px; }
.home-meter-icon { width: 32px; height: 32px; margin-right: 9px; }
.home-meter-track { width: 104px; height: 13px; border-radius: 7px; background-color: rgba(255,255,255,.18); overflow: hidden; }
.home-meter-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; border-radius: 7px; }
.home-meter-fill--energy { background-color: rgb(255,210,63); }
.home-meter-fill--sanity { background-color: rgb(255,126,182); }
.home-meter--low .home-meter-track { border-width: 2px; border-color: rgb(255,210,63); }
.home-meter--critical .home-meter-track { border-width: 2px; border-color: rgb(255,59,92); }

/* ---------------------------------------------------------------- currency strip (skewed dark pills) */
.home-currencies { position: absolute; left: 792px; top: 32px; flex-direction: row; }
.home-pill { flex-direction: row; align-items: center; height: 65px; padding: 0 22px 0 14px; margin-right: 18px; }
.home-pill-icon { width: 54px; height: 54px; margin-right: 13px; }
.home-pill-value { -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 31px; white-space: nowrap; -unity-text-align: middle-left; }
.home-pill-status { -unity-font-definition: url("Fonts/Phone/Inter-Bold.ttf"); font-size: 17px; letter-spacing: 1px; color: rgba(255,255,255,.7); margin-left: 12px; white-space: nowrap; }
.home-pill--dim .home-pill-value { opacity: .6; } /* the Solana mark stays unaltered (brand guidelines) */
.home-sol-mark { width: 47px; height: 36px; margin: 0 12px 0 8px; background-image: url("Brand/solana-logomark.png"); -unity-background-scale-mode: scale-to-fit; }
.home-screen .home-plus { width: 62px; height: 62px; margin: 0 -14px 0 4px; align-items: center; justify-content: center; }
.home-plus-label {
    width: 40px; height: 40px; border-radius: 13px; background-color: rgb(61,220,132);
    -unity-font-definition: url("Fonts/Phone/Inter-Bold.ttf"); font-size: 31px; -unity-text-align: middle-center;
}
.home-screen .home-plus-label { color: rgb(13,61,34); }

/* ---------------------------------------------------------------- top-right corner buttons */
.home-corner { position: absolute; right: 32px; top: 29px; flex-direction: row; }
.home-screen .home-corner-button, .home-screen .home-corner-button:hover, .home-screen .home-corner-button:active,
.home-screen .home-corner-button:focus, .home-screen .home-corner-button:hover:active {
    width: 79px; height: 79px; margin-left: 18px; border-radius: 23px; border-width: 4px;
    border-color: rgba(255,255,255,.14); background-color: rgba(20,6,44,.78); align-items: center; justify-content: center; overflow: visible;
}
.home-corner-icon { width: 50px; height: 50px; }

/* ---------------------------------------------------------------- left rail stickers */
.home-rail { position: absolute; left: 36px; top: 205px; }
.home-screen .lobby-sticker { align-items: center; margin-bottom: 12px; overflow: visible; }
.lobby-sticker-tile { width: 119px; height: 121px; overflow: visible; }
.lobby-sticker-lip { position: absolute; left: 0; right: 0; top: 9px; height: 112px; border-radius: 29px; background-color: rgb(42,11,74); }
.lobby-sticker-face {
    position: absolute; left: 0; right: 0; top: 0; height: 112px; border-radius: 29px; border-width: 5px; border-color: rgb(42,11,74);
    -unity-background-scale-mode: stretch-to-fill; align-items: center; justify-content: center;
}
.lobby-sticker-icon { width: 83px; height: 83px; }
.lobby-sticker-label { font-size: 25px; margin-top: 4px; -unity-text-align: middle-center; white-space: nowrap; }

/* ---------------------------------------------------------------- right column: event tiles + Duo */
.home-right { position: absolute; right: 43px; top: 173px; align-items: flex-end; }
.home-today { align-items: flex-end; }
.home-screen .home-today-chip { width: 335px; margin-bottom: 18px; }
.home-today-box { flex-direction: row; align-items: center; min-height: 86px; padding: 14px 30px 16px 31px; }
.home-today-icon { width: 61px; height: 61px; margin-right: 18px; }
.home-today-copy { flex-shrink: 1; flex-grow: 1; min-width: 0; }
.home-today-caption { -unity-font-definition: url("Fonts/Phone/Inter-Bold.ttf"); font-size: 17px; letter-spacing: 2px; white-space: nowrap; -unity-text-align: middle-left; }
.home-today-value { -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 28px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; }
.home-today--up .home-today-value { color: rgb(124,255,196); }
.home-today--down .home-today-value { color: rgb(255,170,160); }
.home-right > .lobby-sticker { margin-top: 0; margin-right: 18px; }

/* ---------------------------------------------------------------- the character on its mint podium */
/* Square canvas sized so the feet land on the podium centre and raised hands sit below the top strip. */
.home-stage { position: absolute; left: 50%; top: 88px; width: 976px; height: 976px; translate: -50% 0; }
.home-stage-glow { position: absolute; left: 191px; top: 725px; width: 594px; height: 155px; -unity-background-scale-mode: stretch-to-fill; }
.home-stage-shadow { display: none; }
.home-stage-model { position: absolute; left: 0; right: 0; top: 0; bottom: 0; -unity-background-scale-mode: scale-to-fit; }
.home-bubble { left: 54%; top: 150px; max-width: 360px; }

/* ---------------------------------------------------------------- one "Invite fren" slot (right of the player) */
.home-screen .home-invite { position: absolute; left: 50%; margin-left: 373px; bottom: 216px; width: 234px; align-items: center; overflow: visible; }
.home-invite-silhouette {
    width: 234px; height: 450px; opacity: .28; scale: -1 1; background-image: url("Lobby/invite-silhouette.png");
    -unity-background-scale-mode: scale-to-fit;
}
.home-invite-add {
    position: absolute; top: 166px; left: 70px; width: 94px; height: 94px; border-radius: 47px;
    background-color: rgb(255,210,63); border-width: 7px; border-color: rgb(42,11,74); border-bottom-width: 12px;
    align-items: center; justify-content: center;
}
.home-screen .home-invite-plus { -unity-font-definition: url("Fonts/Phone/Inter-Bold.ttf"); font-size: 61px; color: rgb(42,11,74); -unity-text-align: middle-center; margin-top: -4px; }
.home-invite-caption { font-size: 25px; margin-top: 8px; -unity-text-align: middle-center; white-space: nowrap; }

/* ---------------------------------------------------------------- bottom-left: The Dream pass */
.home-screen .home-dream { position: absolute; left: 32px; bottom: 40px; width: 594px; flex-direction: row-reverse; align-items: center; overflow: visible; }
.home-dream-badge {
    width: 115px; height: 115px; border-radius: 32px; border-width: 7px; border-bottom-width: 15px; border-color: rgb(42,11,74);
    background-color: rgb(255,197,48); -unity-background-scale-mode: stretch-to-fill; rotate: -6deg; align-items: center; justify-content: center; flex-shrink: 0;
}
.home-dream-crown { width: 79px; height: 79px; }
.home-dream-body { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-left: -18px; padding: 14px 47px 16px 40px; }
.home-dream-caption { -unity-font-definition: url("Fonts/Phone/Inter-Bold.ttf"); font-size: 18px; letter-spacing: 2px; white-space: nowrap; -unity-text-align: middle-left; }
.home-screen .home-dream-caption { color: rgb(255,210,63); }
.home-dream-row { flex-direction: row; align-items: flex-end; justify-content: space-between; margin-top: 2px; }
.home-dream-title { -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 32px; flex-shrink: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.home-dream-progress { -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf"); font-size: 21px; margin-left: 14px; white-space: nowrap; margin-bottom: 3px; }
.home-screen .home-dream-progress { color: rgba(255,255,255,.7); }
.home-dream-bar { height: 18px; margin-top: 9px; border-radius: 9px; background-color: rgba(255,255,255,.15); overflow: hidden; }
.home-dream-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; border-radius: 9px; background-color: rgb(255,181,46); }

/* ---------------------------------------------------------------- bottom-right: HOME ribbon + ENTER THE CITY */
.home-cta-zone { position: absolute; right: 40px; bottom: 40px; align-items: flex-end; }
.home-screen .home-home { margin-right: 32px; margin-bottom: 4px; }
.home-ribbon { flex-direction: row; align-items: center; height: 66px; padding: 0 34px 7px 30px; }
.home-ribbon-tag {
    -unity-font-definition: url("Fonts/Phone/Inter-Bold.ttf"); font-size: 18px; letter-spacing: 1px; padding: 3px 11px;
    border-radius: 9px; background-color: rgb(255,59,92); margin-right: 11px;
}
.home-ribbon-name { -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 27px; max-width: 420px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.home-screen .home-ribbon-name { color: rgb(42,11,74); }
.home-screen .home-enter { width: 594px; height: 169px; overflow: visible; }
.home-enter-face { position: absolute; left: 0; top: 0; right: 0; bottom: 0; flex-direction: row; align-items: center; justify-content: center; padding: 0 20px 30px 20px; }
.home-screen .home-enter-label { -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 58px; color: rgb(13,61,34); letter-spacing: 1px; white-space: nowrap; }
.home-screen .home-enter-chevron { -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf"); font-size: 62px; color: rgb(13,61,34); margin-left: 25px; margin-top: -4px; }
.home-screen .home-enter:disabled { opacity: .6; }
.home-screen .home-error {
    color: rgb(255,255,255); background-color: rgba(120,10,40,.9); border-radius: 14px; font-size: 28px; max-width: 594px;
    padding: 14px 22px; margin-bottom: 16px; white-space: normal; -unity-font-definition: url("Fonts/Phone/Inter-SemiBold.ttf");
}
