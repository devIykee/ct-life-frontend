.ct-phone.duo-app--timeline .duo-group, .ct-phone.duo-app--timeline .duo-sheet, .ct-phone.duo-app--timeline .duo-page-grouped .duo-circle-face, .ct-phone.duo-app--timeline .duo-circle-face { background-color: #16181C; }
.ct-phone.duo-app--timeline .duo-nav-backdrop { background-color: #000000; border-bottom-color: #2F3336; }
.ct-phone.duo-app--timeline .duo-glass-circle .duo-circle-face, .ct-phone.duo-app--timeline .duo-bottom-bar-face, .ct-phone.duo-app--timeline .duo-board-pin-face, .ct-phone.duo-app--timeline .duo-call-controls { background-color: #16181C; border-color: #2F3336; }
