/* Per-app looks for the Solana Duo (2026-10-30). PhoneShell tags the phone with `duo-app--<id>` while an app is open,
   so each app reads like its real-life counterpart instead of one shared Settings look. Specificity (.ct-phone.duo-app--x
   + one class) beats the kit (.ct-phone + one class), whatever the load order. Palette first, then surfaces the kit
   paints with fixed colours. */

/* ---------- timeline: X: true black, hairline posts, blue accent */
.ct-phone.duo-app--timeline { --duo-label: #E7E9EA; --duo-label2: #A3AEB9; --duo-label3: #71767B; --duo-sep: #2F3336; --duo-grouped: #000000; --duo-fill: #202327; --duo-pressed: #2C3036; --duo-blue: #1D9BF0; --duo-tint: #1D9BF0; --duo-on-blue: #FFFFFF; --duo-green: #00BA7C; --duo-red: #F4212E; }
