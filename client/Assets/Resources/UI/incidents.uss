/* City Wire shares the app palette/type. A card is scenery-friendly, not a modal. */
.ct-incidents { position: absolute; left: 5%; top: 330px; width: 90%; align-items: stretch; }
.ct-landscape .ct-incidents { left: 50%; top: 28px; width: 760px; margin-left: -380px; }
.ct-incident-slot { align-items: stretch; }
.ct-incident-card { flex-direction: row; align-items: flex-start; padding: 20px 18px 18px 22px; border-radius: 24px; border-width: 1px; border-left-width: 5px; border-color: var(--ct-line); border-left-color: var(--ct-game-cyan); background-color: var(--ct-scrim); }
.ct-incident-loss { border-left-color: var(--ct-game-coral); }
.ct-incident-good { border-left-color: var(--ct-game-green); }
.ct-incident-ore { border-left-color: var(--ct-gold); }
.ct-incident-symbol { width: 54px; height: 62px; margin-right: 18px; justify-content: center; flex-shrink: 0; }
.ct-incident-symbol .ct-icon { width: 42px; height: 42px; -unity-background-image-tint-color: var(--ct-game-cyan); }
.ct-incident-loss .ct-icon { -unity-background-image-tint-color: var(--ct-game-coral); }
.ct-incident-good .ct-icon { -unity-background-image-tint-color: var(--ct-game-green); }
.ct-incident-ore .ct-icon { -unity-background-image-tint-color: var(--ct-gold); }
.ct-incident-copy { flex-grow: 1; min-width: 0; }
.ct-incident-eyebrow { font-size: 18px; margin: 0 0 6px 0; color: var(--ct-game-cyan); -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); }
.ct-incident-title { font-size: 30px; margin: 0 0 8px 0; color: var(--ct-card); white-space: normal; -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); }
.ct-incident-body { font-size: 24px; margin: 0 0 6px 0; color: var(--ct-card); white-space: normal; }
.ct-incident-detail { font-size: 24px; margin: 4px 0 6px 0; color: var(--ct-accent); white-space: normal; -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); }
.ct-incident-context { font-size: 19px; margin: 4px 0 0 0; color: var(--ct-line); white-space: normal; }
.ct-incident-close { width: 124px; height: 124px; flex-shrink: 0; margin: -12px -12px -12px 0; padding: 40px; border-width: 0; border-radius: 20px; background-color: rgba(0,0,0,0); }
.ct-incident-close .ct-icon { width: 36px; height: 36px; -unity-background-image-tint-color: var(--ct-card); }
.ct-incident-close:hover { background-color: var(--ct-deep); }
.ct-incident-close:focus { border-width: 2px; border-color: var(--ct-card); }
.ct-incident-history { width: 280px; min-width: 280px; min-height: 124px; align-self: center; flex-shrink: 0; margin: 8px 0 0 0; padding: 24px 28px; font-size: 23px; color: var(--ct-card); border-width: 1px; border-color: var(--ct-line); border-radius: 20px; background-color: var(--ct-scrim); -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); }
.ct-incident-history:hover { background-color: var(--ct-deep); }
.ct-incident-history:focus { border-width: 3px; border-color: var(--ct-accent); }
.ct-incident-close > .ct-button-depth, .ct-incident-close > .ct-button-glint, .ct-incident-history > .ct-button-depth, .ct-incident-history > .ct-button-glint { display: none; }
.ct-incident-drawer { margin-top: 12px; padding: 22px; border-radius: 24px; border-width: 1px; border-color: var(--ct-line); background-color: var(--ct-scrim); max-height: 850px; }
.ct-landscape .ct-incident-drawer { max-height: 560px; }
.ct-incident-drawer-heading { flex-direction: row; align-items: center; flex-shrink: 0; }
.ct-incident-drawer-title { font-size: 30px; color: var(--ct-card); flex-grow: 1; min-width: 0; white-space: normal; -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); }
.ct-incident-receipts { flex-shrink: 1; min-height: 0; }
.ct-incident-receipt { margin: 12px 0; padding: 12px 16px; border-left-width: 3px; border-left-color: var(--ct-game-cyan); }
.ct-incident-receipt-title { font-size: 26px; color: var(--ct-card); margin: 0 0 8px 0; white-space: normal; -unity-font-definition: url("Fonts/Manrope-Semibold.ttf"); }
