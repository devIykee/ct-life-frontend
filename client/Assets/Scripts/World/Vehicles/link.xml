<!--
  Feel lane F2: VehicleWorld binds to World v2's island API (IslandStreamer, IslandMarkers) by reflection until the
  vehicles and world branches meet, so nothing else may reference those members. Keep IL2CPP (Medium stripping) from
  removing them. Replace with direct calls (and drop this file) once World v2 is on the same branch.
-->
<linker>
  <assembly fullname="CTLife.World" ignoreIfMissing="1">
    <type fullname="CTLife.World.IslandStreamer" preserve="all" />
    <type fullname="CTLife.World.IslandMarkers" preserve="all" />
    <type fullname="CTLife.World.VehicleClass" preserve="all" />
    <type fullname="CTLife.World.VehicleSpawn" preserve="all" />
    <type fullname="CTLife.World.HeliPad" preserve="all" />
    <type fullname="CTLife.World.TrafficZone" preserve="all" />
  </assembly>
</linker>
