<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application>
    <!-- ctlife:// links (quest and push deep links) open the game; Unity's activity gets this filter by manifest merge -->
    <activity android:name="com.unity3d.player.UnityPlayerGameActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="ctlife" />
      </intent-filter>
    </activity>
    <service android:name="com.ctlife.push.CTPushService" android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
    <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="ctlife_default" />
  </application>
</manifest>
