+        private static void CheckChairBack(GameObject chair,string spotId)
+        {
+            // Verify the actual Unity-imported mesh, not only the Blender axis inference.
+            var points=chair.GetComponentsInChildren<MeshFilter>(true).Where(f=>Lod(f.name)==0)
